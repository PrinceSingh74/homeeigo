# Copy to .env.local and point at your backend (same as partner-web / homigo-mobile)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Must match backend RAZORPAY_KEY_ID (test key for dev)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Google Maps — ANDROID ONLY (iOS uses Apple Maps and needs no key).
# Must be restricted to package com.homeeigo.partner + your signing SHA-1.
# The customer app's key is restricted to a different package and will NOT work here.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Sentry (partner app's OWN project — do not reuse the customer app's) ──
# Runtime DSN. Absent = Sentry disabled cleanly (no crash, no overhead).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map upload via the Sentry Expo plugin.
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry CLI auth for source-map upload in EAS builds. Store as an EAS SECRET, never commit.
SENTRY_AUTH_TOKEN=

# ── EAS ──
# Issued by `eas init`. Never invent this value.
EAS_PROJECT_ID=
# development | preview | production — set automatically by EAS build profiles.
EXPO_PUBLIC_APP_ENV=development
