{
  "expo": {
    "name": "HOMEEIGO Partner",
    "slug": "homigo-partner-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "homeeigo-partner",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f1d6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeeigo.partner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HOMEEIGO Partner uses your location for job navigation, attendance check-in, and territory insights."
      }
    },
    "android": {
      "package": "com.homeeigo.partner",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3d6b4f"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HOMEEIGO Partner to use your location for jobs and attendance."
        }
      ]
    ]
  }
}
