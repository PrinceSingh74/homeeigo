# Backend API base URL
# ─────────────────────────────────────────────────────────────────────────────
# Physical device / Expo Go: NEVER use localhost — the phone cannot reach your PC.
# Use your PC's LAN IP (same network as the phone). Example from `ipconfig`:
#
#   EXPO_PUBLIC_API_URL=http://10.191.60.32:3000
#
# If unset, dev builds auto-resolve from Expo Metro hostUri (QR code IP).
# Android emulator fallback: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000 works
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://10.191.60.32:3000

# Razorpay publishable key (same as web)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# OAuth redirect URIs (must match backend + provider console)
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=homigo://auth/google/callback
EXPO_PUBLIC_APPLE_REDIRECT_URI=homigo://auth/apple/callback

# Sentry (optional — crash reporting disabled when unset)
EXPO_PUBLIC_SENTRY_DSN=
