{
  "expo": {
    "name": "HOMEEIGO",
    "slug": "homigo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "homigo",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "runtimeVersion": "1.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0FDF4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homigo.mobile",
      "buildNumber": "1",
      "config": {
        "googleMapsApiKey": "AIzaSyCHxF9zmbEdcgoO0G66PB42Ln3vif6pZNY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HOMIGO uses your location to find nearby providers and track your service.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homigo.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCHxF9zmbEdcgoO0G66PB42Ln3vif6pZNY"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e78603fa-82a0-442a-ac86-e59c4629b235"
      },
      "router": {}
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "homigo-g4",
          "project": "node-fastify"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HOMIGO to access your location."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      "expo-updates"
    ],
    "owner": "harekrishna_2003",
    "updates": {
      "url": "https://u.expo.dev/e78603fa-82a0-442a-ac86-e59c4629b235"
    }
  }
}
