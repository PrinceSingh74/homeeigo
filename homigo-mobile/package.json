{
  "name": "homigo-mobile",
  "version": "1.0.0",
  "description": "HOMIGO - Premium Home Services React Native Mobile App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "design:lint": "node scripts/design-lint.mjs",
    "design:lint:strict": "node scripts/design-lint.mjs --strict",
    "startup:lint": "node scripts/startup-lint-guards.mjs",
    "startup:scenarios": "node scripts/startup-scenario-matrix.mjs",
    "startup:budget": "node scripts/startup-performance-budget-check.mjs",
    "startup:certify": "node scripts/startup-certification.mjs",
    "startup:regression": "node scripts/startup-regression-ci.mjs",
    "verify:netinfo": "node scripts/verify-netinfo-subscriptions.mjs",
    "verify:realtime-cache": "node scripts/stress-realtime-cache.mjs",
    "verify:sentry": "node scripts/sentry-mobile-verify.mjs",
    "verify:alerts": "node scripts/verify-mobile-alerts.mjs",
    "verify:telemetry-queue": "node scripts/verify-telemetry-queue.mjs",
    "certify:realtime": "node scripts/certify-realtime-stream.mjs",
    "validate:prometheus": "node scripts/validate-prometheus-production.mjs",
    "validate:sentry": "node scripts/validate-sentry-production.mjs",
    "certify:devices": "node scripts/device-certification-checklist.mjs",
    "certify:sentry": "node scripts/certify-sentry-production.mjs",
    "probe:sentry-native": "node scripts/probe-sentry-native.mjs",
    "certify:native-sentry-device": "node scripts/certify-native-sentry-device.mjs",
    "collect:native-sentry-device": "node scripts/collect-native-sentry-device-evidence.mjs",
    "doc:native-sentry-device": "node scripts/generate-native-sentry-device-cert.mjs",
    "certify:prometheus": "node scripts/certify-live-prometheus.mjs",
    "certify:telemetry-replay": "node scripts/certify-telemetry-replay.mjs",
    "certify:ecosystem": "node scripts/certify-ecosystem.mjs",
    "certify:device-matrix": "node scripts/certify-device-matrix.mjs",
    "certify:eas": "node scripts/certify-eas-build.mjs",
    "validate": "npx expo-doctor",
    "build:verify": "npx expo export --platform web --output-dir .expo-export-test",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:aab": "eas build --platform android --profile production",
    "build:ios:ipa": "eas build --platform ios --profile production",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.7.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.468.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-razorpay": "^2.3.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "zod": "^3.23.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "prettier": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
