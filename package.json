{
  "name": "homigo",
  "version": "1.0.0",
  "description": "AI-Powered Luxury Home Services Marketplace",
  "private": true,
  "scripts": {
    "dev": "concurrently -n customer,partner,backend -c blue,magenta,green \"npm run dev:customer\" \"npm run dev:partner\" \"npm run dev:backend\"",
    "dev:customer": "npm run dev --prefix apps/web",
    "dev:partner": "npm run dev --prefix apps/partner-web",
    "dev:admin": "npm run dev --prefix apps/admin-panel",
    "dev:web": "npm run dev:customer",
    "dev:backend": "npm run dev --prefix apps/backend",
    "dev:mobile": "npm run start --prefix homigo-mobile",
    "dev:partner-mobile": "npm run start --prefix homigo-partner-mobile",
    "dev:all": "concurrently -n customer,partner,admin,backend \"npm run dev:customer\" \"npm run dev:partner\" \"npm run dev:admin\" \"npm run dev:backend\"",
    "build": "npm run build:customer && npm run build:partner && npm run build:backend",
    "build:customer": "npm run build --prefix apps/web",
    "build:partner": "npm run build --prefix apps/partner-web",
    "build:admin": "npm run build --prefix apps/admin-panel",
    "build:web": "npm run build:customer",
    "build:backend": "npm run build --prefix apps/backend",
    "start": "npm run start:web && npm run start:backend",
    "start:web": "npm run start --prefix apps/web",
    "start:partner": "npm run start --prefix apps/partner-web",
    "start:backend": "npm run start --prefix apps/backend",
    "enterprise:e2e": "bun run scripts/enterprise/run-e2e-suite.ts",
    "enterprise:mobile": "bun run scripts/enterprise/run-mobile-runtime.ts",
    "enterprise:load": "cd apps/backend && bun run enterprise:load",
    "enterprise:observability": "cd apps/backend && bun run enterprise:observability",
    "lint": "eslint . --ext ts,tsx",
    "test": "jest",
    "test:e2e:web": "npm run test:e2e --prefix apps/web",
    "test:e2e:admin": "npm run test:e2e --prefix apps/admin-panel",
    "test:e2e:partner": "npm run test:e2e --prefix apps/partner-web",
    "test:e2e:all": "npm run test:e2e:web && npm run test:e2e:admin && npm run test:e2e:partner",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules apps/*/node_modules .turbo dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "homigo",
    "home-services",
    "marketplace",
    "ai-powered",
    "luxury",
    "India"
  ],
  "author": "Your Name",
  "license": "MIT",
  "workspaces": [
    "homigo-mobile",
    "homigo-partner-mobile"
  ],
  "overrides": {
    "ws": "^8.18.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "expo-dev-client": "~6.0.21",
    "jose": "^6.2.3"
  }
}
