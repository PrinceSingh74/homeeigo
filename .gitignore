# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (secrets — templates like .env.example remain tracked)
.env
.env.*
!.env.example
.env.local
.env.*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
.next/
dist/
build/
out/

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Monorepo
.turbo/

# Database
*.db
*.sqlite
*.sqlite3

# Expo local cache
.expo/

# Scratch directories written by audit/validation runs. `.step8-tmp` alone holds ~33k files;
# none of it is source, and letting it reach the index buries every real change under it.
.step8-tmp/
measurements/
.validation-tmp/
.rzp-checkout-tmp/

# Incremental TypeScript build state — machine-specific, regenerated on every build.
*.tsbuildinfo
