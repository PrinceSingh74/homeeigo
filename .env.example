# ENVIRONMENT
NODE_ENV=development
APP_ENV=dev

# BRANDING
APP_NAME=HOMIGO
APP_TAGLINE=The Future of Home Services
APP_VERSION=1.0.0

# API URLS
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/homigo_db

# REDIS
REDIS_URL=redis://localhost:6379

# AUTHENTICATION
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# OAUTH (For Phase 2)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id

# PAYMENTS (For Phase 3)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
# RazorpayX business account number (payout source account)
RAZORPAY_ACCOUNT_NUMBER=

# EXTERNAL SERVICES (For Phase 4)
# AI provider chain — first entry is primary, rest are ordered fallbacks.
AI_PROVIDER_ORDER=ANTHROPIC,GEMINI,GROQ,OPENAI
ANTHROPIC_API_KEY=your-anthropic-key
AI_ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
AI_GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-key
GCP_PROJECT_ID=your-gcp-project
AI_GATEWAY_ENABLED=true
AI_GATEWAY_DRY_RUN=false
AI_BRAIN_ENABLED=true
AI_CONTEXT_CACHE_TTL=300
AI_CONTEXT_SNAPSHOT_TTL_HOURS=24
AI_PROMPT_COMPRESSION_THRESHOLD=0.8
AI_TOOLS_ENABLED=true
# Set true only for certification/load benchmarks (bypasses per-tool rate limits)
AI_TOOL_CERTIFICATION_MODE=false
AI_TOOL_RATE_LIMIT_PER_MINUTE=30

# MONITORING (For Phase 6)
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=homigo-g4
SENTRY_PROJECT=node-fastify
POSTHOG_KEY=your-posthog-key
AXIOM_TOKEN=your-axiom-token

# FEATURE FLAGS
ENABLE_AI=true
ENABLE_LIVE_TRACKING=true
ENABLE_PREMIUM_FEATURES=true
