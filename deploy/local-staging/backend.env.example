# Environment for the local staging backend container (deploy/local-staging/deploy-backend.ps1).
# Copy to backend.env (gitignored) and generate STAGING-ONLY secrets — never reuse dev or prod values.
#   openssl rand -hex 32   -> ENCRYPTION_KEY (64 hex), MASTER_ENCRYPTION_KEY, HASH_HMAC_KEY
#   openssl rand -base64 48 -> JWT_SECRET, JWT_REFRESH_SECRET, OTP_SECRET
# The container joins the compose network homigo-staging_default, so service names resolve.
NODE_ENV=production
APP_ENV=staging
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:homigo_staging@postgres:5432/homigo_staging_db
REDIS_URL=redis://redis:6379
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY=
HASH_HMAC_KEY=
OTP_SECRET=
TRUST_PROXY_HOPS=0
FRONTEND_URL=http://localhost:3001
PARTNER_WEB_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3003
EVENTS_OUTBOX_ENABLED=false
EVENTS_CONSUMERS_ENABLED=false
SENTRY_ENVIRONMENT=staging
LOCAL_UPLOAD_ROOT=/app/uploads
OBJECT_STORAGE_DRIVER=local
REGISTER_REQUIRE_OTP=false
# Autonomous maintenance (ledger integrity, payment expiry, backups…) only runs when the target is
# named explicitly. Name the staging database to exercise it; leave unset to serve requests only.
MAINTENANCE_AUTHORIZED_TARGET=postgres:5432/homigo_staging_db
