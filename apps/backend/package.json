{
  "name": "homigo-backend",
  "version": "1.0.0",
  "description": "HOMIGO Backend - Bun + Elysia.js",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --env-file=.env run --watch src/index.ts",
    "check:log-governance": "bun run scripts/check-log-governance.ts",
    "prebuild": "bun run scripts/check-log-governance.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "bun --env-file=.env run scripts/seed.ts",
    "migrate:pii": "bun --env-file=.env run scripts/migrate-user-pii-encryption.ts",
    "migrate:provider-sensitive": "bun --env-file=.env run scripts/migrate-provider-sensitive.ts",
    "verify:pii": "bun --env-file=.env run scripts/verify-pii-encryption.ts",
    "verify:money-drift": "bun --env-file=.env run scripts/run-money-drift.ts",
    "verify:booking-overlaps": "bun --env-file=.env run scripts/verify-booking-overlaps.ts",
    "audit:db": "bun --env-file=.env run scripts/audit-db-integrity.ts",
    "audit:kpi": "bun --env-file=.env run scripts/kpi-validation-audit.ts",
    "audit:sentry": "bun --env-file=.env run scripts/sentry-forensic-audit.ts",
    "audit:finance-remediation": "bun --env-file=.env run scripts/recovery/finance-remediation.ts --apply",
    "audit:migrations": "bun --env-file=.env run scripts/recovery/migration-integrity-audit.ts --repair",
    "audit:phase0": "bun --env-file=.env run scripts/phase0-discovery-sql.ts",
    "migrate:address": "bun --env-file=.env run scripts/migrate-address-encryption.ts",
    "reconcile:ledger": "bun --env-file=.env run scripts/reconcile-ledger.ts",
    "verify:payment": "bun --env-file=.env run scripts/verify-payment-idempotency.ts",
    "cert:finance-intelligence": "bun --env-file=.env run scripts/enterprise/finance-intelligence-certification.ts",
    "cert:finance-config": "bun --env-file=.env run scripts/enterprise/finance-config-certification.ts",
    "cert:customer-intelligence": "bun --env-file=.env run scripts/enterprise/customer-intelligence-certification.ts",
    "cert:growth-intelligence": "bun --env-file=.env run scripts/enterprise/growth-intelligence-certification.ts",
    "cert:risk-intelligence": "bun --env-file=.env run scripts/enterprise/risk-intelligence-certification.ts",
    "cert:platform-intelligence": "bun --env-file=.env run scripts/enterprise/platform-intelligence-certification.ts",
    "cert:recovery-intelligence": "bun --env-file=.env run scripts/enterprise/recovery-intelligence-certification.ts",
    "cert:v6-final": "bun --env-file=.env run scripts/enterprise/v6-final-certification.ts",
    "cert:razorpay": "bun run scripts/razorpay-test-certification.ts",
    "cert:razorpay:refund": "bun run scripts/razorpay-refund-certification.ts",
    "cert:platform": "bun run scripts/platform-maturity-certification.ts",
    "cert:phase25": "bun --env-file=.env.test run scripts/phase25-enterprise-certification.ts",
    "cert:phase4": "bun --env-file=.env run scripts/phase-4-certification.ts",
    "bench:phase4": "bun --env-file=.env run scripts/phase-4-benchmark.ts",
    "test:ai-brain": "bun test src/__tests__/ai-brain.test.ts",
    "cert:recovery": "bun test src/__tests__/failure-recovery-certification.test.ts",
    "enterprise:load": "bun --env-file=.env run scripts/enterprise/run-load-suite.ts",
    "enterprise:observability": "bun --env-file=.env run scripts/enterprise/run-observability-validation.ts",
    "db:seed-services": "bun --env-file=.env run scripts/seed-services.ts",
    "test:setup": "bun run scripts/setup-test-db.ts",
    "db:setup": "bun run scripts/setup-db.ts",
    "backup:db": "bun --env-file=.env run scripts/backup-db.ts",
    "backup:retention": "bun --env-file=.env run scripts/apply-backup-retention.ts",
    "backup:verify-restore": "bun --env-file=.env run scripts/verify-backup-restore.ts",
    "cert:backup": "bun --env-file=.env run scripts/backup-enterprise-certification.ts",
    "cert:auth-bootstrap": "bun --env-file=.env run scripts/enterprise/auth-bootstrap-certification.ts",
    "cert:metrics": "bun --env-file=.env run scripts/enterprise/metrics-certification.ts",
    "cert:final": "bun --env-file=.env run scripts/enterprise/final-enterprise-certification.ts",
    "restore:db": "bun --env-file=.env run scripts/restore-postgres.ts",
    "smoke:redis": "bun run scripts/smoke-redis.ts",
    "smoke:ws-fanout": "bun run scripts/smoke-ws-fanout.ts",
    "smoke:entitlements": "bun --env-file=.env run scripts/smoke-entitlements.ts",
    "smoke:membership": "bun --env-file=.env run scripts/smoke-membership-premium.ts",
    "smoke:fraud": "bun --env-file=.env run scripts/smoke-referral-fraud.ts",
    "smoke:lifecycle": "bun --env-file=.env run scripts/smoke-account-lifecycle.ts",
    "reconcile:payments": "bun --env-file=.env run scripts/reconcile-pending-payments.ts",
    "auth:cleanup": "bun run scripts/cleanup-auth.ts",
    "smoke:part3": "bun run scripts/smoke-part3.ts",
    "smoke:partner": "bun run scripts/smoke-partner-routes.ts",
    "smoke:provider": "bun run scripts/smoke-provider-api.ts",
    "smoke:admin": "bun run scripts/smoke-admin-api.ts",
    "smoke:stack": "bun --env-file=.env run scripts/verify-full-stack.ts",
    "ensure:demo-partner": "bun --env-file=.env run scripts/ensure-demo-partner.ts",
    "ensure:demo-users": "bun --env-file=.env run scripts/ensure-demo-users.ts",
    "e2e:cancel-refund": "bun --env-file=.env run scripts/e2e-cancel-refund.ts",
    "smoke:finance": "bun --env-file=.env run scripts/smoke-finance-ops.ts",
    "validate:production": "bun --env-file=.env run scripts/production-validation.ts",
    "ops:resolve-stale": "bun --env-file=.env run scripts/resolve-stale-ops-alerts.ts",
    "ops:resolve-stale:apply": "bun --env-file=.env run scripts/resolve-stale-ops-alerts.ts --apply",
    "load-test": "bun run scripts/load-test/runner.ts",
    "load-test:100": "bun run scripts/load-test/runner.ts --scenario all --concurrency 100",
    "load-test:500": "bun run scripts/load-test/runner.ts --scenario all --concurrency 500",
    "load-test:1000": "bun run scripts/load-test/runner.ts --scenario all --concurrency 1000",
    "k6:booking": "k6 run -e STAGE=100 scripts/load-test/k6/booking.js",
    "k6:payment": "k6 run -e STAGE=100 scripts/load-test/k6/payment.js",
    "k6:wallet": "k6 run -e STAGE=100 scripts/load-test/k6/wallet.js",
    "p2:grafana": "bun run scripts/p2-validation/grafana-coverage.ts",
    "p2:alerts": "bun run scripts/p2-validation/alert-reliability.ts",
    "p2:dr": "bun --env-file=.env run scripts/p2-validation/dr-restore-drill.ts",
    "p2:s3": "bun --env-file=.env run scripts/p2-validation/s3-backup-validation.ts",
    "p2:sentry": "bun --env-file=.env run scripts/p2-validation/sentry-synthetic.ts",
    "p2:wallet-integrity": "bun --env-file=.env run scripts/p2-validation/wallet-integrity-check.ts",
    "p2:cluster": "bun --env-file=.env run scripts/p2-validation/cluster-validation.ts",
    "cert:infra": "bun --env-file=.env run scripts/infrastructure-certification.ts",
    "cert:ecosystem": "bun --env-file=.env run scripts/ecosystem-enterprise-certification.ts",
    "p2:pentest": "bun --env-file=.env run scripts/p2-validation/pentest.ts",
    "p2:static": "bun run p2:grafana && bun run p2:alerts",
    "smoke:all": "bun run smoke:part3 && bun run smoke:partner && bun run smoke:provider && bun run smoke:admin && bun run scripts/phase2-lifecycle-checks.ts",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@elysiajs/cors": "latest",
    "@elysiajs/jwt": "latest",
    "@elysiajs/static": "latest",
    "@elysiajs/swagger": "latest",
    "@google-cloud/aiplatform": "^6.8.1",
    "@google-cloud/bigquery": "^8.3.1",
    "@prisma/client": "^6.19.3",
    "@sentry/bun": "^10.56.0",
    "axios": "latest",
    "bcryptjs": "latest",
    "dotenv": "latest",
    "elysia": "latest",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^6.1.0",
    "google-auth-library": "latest",
    "jsonwebtoken": "latest",
    "pdfkit": "^0.19.0",
    "pg": "latest",
    "prisma": "^6.19.3",
    "redis": "latest",
    "resend": "^6.12.4",
    "twilio": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/pdfkit": "^0.17.6",
    "eslint": "latest",
    "globals": "^17.6.0",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.60.0"
  }
}
