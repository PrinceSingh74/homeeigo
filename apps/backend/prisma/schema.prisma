generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                         @id @default(cuid())
  email                         String?
  phoneNumber                   String?                        @map("phone_number")
  emailEncrypted                String?                        @map("email_encrypted")
  emailHash                     String?                        @unique @map("email_hash")
  emailEncryptionKeyVersion     Int?                           @map("email_encryption_key_version")
  phoneEncrypted                String?                        @map("phone_encrypted")
  phoneHash                     String?                        @unique @map("phone_hash")
  phoneEncryptionKeyVersion     Int?                           @map("phone_encryption_key_version")
  dataEncryptionStatus          DataEncryptionStatus           @default(PARTIAL) @map("data_encryption_status")
  dataEncryptedAt               DateTime?                      @map("data_encrypted_at")
  firstName                     String                         @map("first_name")
  lastName                      String                         @map("last_name")
  profileImage                  String?                        @map("profile_image")
  bio                           String?
  dateOfBirth                   DateTime?                      @map("date_of_birth")
  gender                        String?
  role                          UserRole                       @default(CUSTOMER)
  password                      String
  passwordChangedAt             DateTime?                      @map("password_changed_at")
  passwordResetToken            String?                        @unique @map("password_reset_token")
  passwordResetExpires          DateTime?                      @map("password_reset_expires")
  isEmailVerified               Boolean                        @default(false) @map("is_email_verified")
  emailVerifiedAt               DateTime?                      @map("email_verified_at")
  isPhoneVerified               Boolean                        @default(false) @map("is_phone_verified")
  phoneVerifiedAt               DateTime?                      @map("phone_verified_at")
  isActive                      Boolean                        @default(true) @map("is_active")
  isBanned                      Boolean                        @default(false) @map("is_banned")
  bannedReason                  String?                        @map("banned_reason")
  bannedAt                      DateTime?                      @map("banned_at")
  kycStatus                     KycStatus                      @default(NOT_STARTED) @map("kyc_status")
  kycDocumentUrl                String?                        @map("kyc_document_url")
  kycDocumentType               String?                        @map("kyc_document_type")
  kycDocumentNumber             String?                        @map("kyc_document_number")
  kycVerifiedAt                 DateTime?                      @map("kyc_verified_at")
  kycRejectionReason            String?                        @map("kyc_rejection_reason")
  defaultAddressId              String?                        @map("default_address_id")
  preferredCity                 String?                        @map("preferred_city")
  defaultLanguage               String                         @default("en") @map("default_language")
  timezone                      String                         @default("Asia/Kolkata")
  darkMode                      Boolean                        @default(false) @map("dark_mode")
  notificationsEnabled          Boolean                        @default(true) @map("notifications_enabled")
  emailNotifications            Boolean                        @default(true) @map("email_notifications")
  pushNotifications             Boolean                        @default(true) @map("push_notifications")
  smsNotifications              Boolean                        @default(true) @map("sms_notifications")
  walletBalance                 Float                          @default(0) @map("wallet_balance")
  walletBalancePaise            BigInt                         @default(0) @map("wallet_balance_paise")
  walletCurrency                String                         @default("INR") @map("wallet_currency")
  totalSpent                    Float                          @default(0) @map("total_spent")
  totalSpentPaise               BigInt                         @default(0) @map("total_spent_paise")
  totalSaved                    Float                          @default(0) @map("total_saved")
  totalSavedPaise               BigInt                         @default(0) @map("total_saved_paise")
  referralCode                  String?                        @unique @map("referral_code")
  referredBy                    String?                        @map("referred_by")
  referralCount                 Int                            @default(0) @map("referral_count")
  referralBonusUsed             Boolean                        @default(false) @map("referral_bonus_used")
  lastLoginAt                   DateTime?                      @map("last_login_at")
  lastActivityAt                DateTime?                      @map("last_activity_at")
  loginCount                    Int                            @default(0) @map("login_count")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  deletedAt                     DateTime?                      @map("deleted_at")
  kycDocumentNumberHash         String?                        @unique @map("kyc_document_number_hash")
  emailVerificationExpires      DateTime?                      @map("email_verification_expires")
  emailVerificationToken        String?                        @unique @map("email_verification_token")
  deletionScheduledAt           DateTime?                      @map("deletion_scheduled_at")
  activityLogs                  ActivityLog[]
  addresses                     Address[]
  adminProfile                  AdminUser?
  aiConversations               AiConversation[]
  bookings                      Booking[]
  consentRecords                ConsentRecord[]
  couponUsages                  CouponUsage[]
  fraudAlerts                   FraudAlert[]
  fraudRiskScore                FraudRiskScore?
  fraudSignals                  FraudSignal[]
  giftCardTransactions          GiftCardTransaction[]
  giftCardsPurchased            GiftCard[]                     @relation("GiftPurchaser")
  giftCardsReceived             GiftCard[]                     @relation("GiftRecipient")
  hcoinTransactions             HCoinTransaction[]
  hcoinWallet                   HCoinWallet?
  benefitUsages                 MembershipBenefitUsage[]
  membershipCashbacks           MembershipCashback[]
  membershipCouponRedemptions   MembershipCouponRedemption[]
  notifications                 Notification[]
  otps                          OTP[]
  partnerRegistrationSession      PartnerRegistrationSession?
  passwordHistories             PasswordHistory[]
  payments                      Payment[]
  providerMatchScores           ProviderMatchScore[]
  provider                      Provider?
  ratingsGiven                  Rating[]
  referralCommissions           ReferralCommission[]           @relation("RefCommissionEarned")
  referralsReceived             ReferralTransaction?           @relation("ReferralReceived")
  referralsMade                 ReferralTransaction[]          @relation("ReferralsMade")
  referralWithdrawals           ReferralWithdrawal[]
  refreshTokens                 RefreshToken[]
  supportTickets                SupportTicket[]
  tokenBlacklist                TokenBlacklist[]
  authEpoch                     UserAuthEpoch?
  devices                       UserDevice[]
  subscriptions                 UserSubscription[]
  walletTransactions            WalletTransaction[]
  transfersReceived             WalletTransfer[]               @relation("TransferRecipient")
  transfersSent                 WalletTransfer[]               @relation("TransferSender")
  complianceRequests            ComplianceRequest[]
  complianceRequestAudits       ComplianceRequestAudit[]
  dataExportRequests            DataExportRequest[]
  deletionRequests              DeletionRequest[]
  savedPaymentMethods           SavedPaymentMethod[]

  @@index([emailHash])
  @@index([phoneHash])
  @@index([kycStatus])
  @@index([isActive])
  @@index([isBanned])
  @@index([role])
  @@index([createdAt])
  @@index([referralCode])
  @@index([deletedAt])
  @@map("users")
}

model UserDevice {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  deviceId       String       @map("device_id")
  platform       PushPlatform
  deviceName     String?      @map("device_name")
  appVersion     String?      @map("app_version")
  osVersion      String?      @map("os_version")
  expoPushToken  String       @unique @map("expo_push_token")
  tokenUpdatedAt DateTime     @default(now()) @map("token_updated_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  isActive       Boolean      @default(true) @map("is_active")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("user_devices")
}

model OTP {
  id           String    @id @default(cuid())
  userId       String?   @map("user_id")
  phoneNumber  String?   @map("phone_number")
  phoneHash    String?   @map("phone_hash")
  otpHash      String    @map("otp_hash")
  expiresAt    DateTime  @map("expires_at")
  isUsed       Boolean   @default(false) @map("is_used")
  attemptCount Int       @default(0) @map("attempt_count")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, createdAt])
  @@index([phoneHash, createdAt])
  @@index([expiresAt])
  @@index([userId])
  @@map("otps")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_histories")
}

model Provider {
  id                           String                         @id @default(cuid())
  userId                       String                         @unique @map("user_id")
  businessName                 String?                        @map("business_name")
  businessLicense              String?                        @unique @map("business_license")
  taxId                        String?                        @map("tax_id")
  serviceCategories            String[]                       @map("service_categories")
  serviceRegions               String[]                       @map("service_regions")
  bio                          String?
  isVerified                   Boolean                        @default(false) @map("is_verified")
  verificationDate             DateTime?                      @map("verification_date")
  verificationNotes            String?                        @map("verification_notes")
  certifications               String[]
  backgroundCheckStatus        BackgroundCheckStatus          @default(NOT_DONE) @map("background_check_status")
  backgroundCheckDate          DateTime?                      @map("background_check_date")
  profileImage                 String?                        @map("profile_image")
  rating                       Float                          @default(0)
  totalReviews                 Int                            @default(0) @map("total_reviews")
  ratingBreakdown              String?                        @map("rating_breakdown")
  totalBookings                Int                            @default(0) @map("total_bookings")
  completedBookings            Int                            @default(0) @map("completed_bookings")
  cancelledBookings            Int                            @default(0) @map("cancelled_bookings")
  rejectedBookings             Int                            @default(0) @map("rejected_bookings")
  completionRate               Float                          @default(0) @map("completion_rate")
  responseRate                 Float                          @default(0) @map("response_rate")
  cancellationRate             Float                          @default(0) @map("cancellation_rate")
  onTimeRate                   Float                          @default(0) @map("on_time_rate")
  acceptanceRate               Float                          @default(0) @map("acceptance_rate")
  avgResponseTime              Float                          @default(0) @map("avg_response_time")
  avgCompletionTime            Float                          @default(0) @map("avg_completion_time")
  isOnline                     Boolean                        @default(false) @map("is_online")
  onlineSince                  DateTime?                      @map("online_since")
  lastSeenAt                   DateTime?                      @map("last_seen_at")
  currentStatus                String                         @default("offline") @map("current_status")
  workingHoursStart            String?                        @map("working_hours_start")
  workingHoursEnd              String?                        @map("working_hours_end")
  workingDays                  String[]                       @map("working_days")
  walletBalance                Float                          @default(0) @map("wallet_balance")
  walletBalancePaise           BigInt                         @default(0) @map("wallet_balance_paise")
  totalEarnings                Float                          @default(0) @map("total_earnings")
  totalEarningsPaise           BigInt                         @default(0) @map("total_earnings_paise")
  thisMonthEarnings            Float                          @default(0) @map("this_month_earnings")
  thisWeekEarnings             Float                          @default(0) @map("this_week_earnings")
  commissionRate               Float                          @default(20) @map("commission_rate")
  bankAccountHolder            String?                        @map("bank_account_holder")
  bankAccountNumber            String?                        @map("bank_account_number")
  bankIfscCode                 String?                        @map("bank_ifsc_code")
  bankName                     String?                        @map("bank_name")
  paymentMethodPreference      String                         @default("bank_transfer") @map("payment_method_preference")
  upiId                        String?                        @map("upi_id")
  isActive                     Boolean                        @default(true) @map("is_active")
  isBanned                     Boolean                        @default(false) @map("is_banned")
  bannedReason                 String?                        @map("banned_reason")
  bannedAt                     DateTime?                      @map("banned_at")
  isApproved                   Boolean                        @default(false) @map("is_approved")
  approvalNotes                String?                        @map("approval_notes")
  pushTokens                   String[]                       @map("push_tokens")
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime                       @updatedAt @map("updated_at")
  badges                       String[]                       @default([])
  registrationStatus           PartnerRegistrationStatus      @default(PENDING) @map("registration_status")
  registeredAt                 DateTime                       @default(now()) @map("registered_at")
  partnerApprovedAt            DateTime?                      @map("partner_approved_at")
  rejectedAt                   DateTime?                      @map("rejected_at")
  rejectionReason              String?                        @map("rejection_reason")
  city                         String?
  experienceYears              Int                            @default(0) @map("experience_years")
  panNumber                    String?                        @map("pan_number")
  aadharNumber                 String?                        @map("aadhar_number")
  adminApprovedBy              String?                        @map("admin_approved_by")
  taxIdHash                    String?                        @unique @map("tax_id_hash")
  bankAccountNumberHash        String?                        @unique @map("bank_account_number_hash")
  upiIdHash                    String?                        @unique @map("upi_id_hash")
  panNumberHash                String?                        @unique @map("pan_number_hash")
  aadharNumberHash             String?                        @unique @map("aadhar_number_hash")
  reservedBalance              Float                          @default(0) @map("reserved_balance")
  reservedBalancePaise         BigInt                         @default(0) @map("reserved_balance_paise")
  activityLogs                 ActivityLog[]
  assignmentAttempts           AssignmentAttempt[]
  bookings                     Booking[]
  earnings                     Earning[]
  locationHistory              LocationHistory[]
  currentLocation              Location?
  notifications                Notification[]
  partnerBackgroundCheck       PartnerBackgroundCheck?
  documents                    ProviderDocument[]
  providerMatchScores          ProviderMatchScore[]
  walletReservations           ProviderWalletReservation[]
  attendanceSessions           PartnerAttendanceSession[]
  incentivePayouts             PartnerIncentivePayout[]
  academyProgress              PartnerAcademyProgress[]
  user                         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews                      Rating[]                       @relation("ProviderReviews")
  supportTickets               SupportTicket[]
  walletTransactions           WalletTransaction[]
  withdrawals                  Withdrawal[]

  @@index([isOnline])
  @@index([rating])
  @@index([isVerified])
  @@index([isApproved])
  @@index([registrationStatus])
  @@index([isActive])
  @@index([completionRate])
  @@index([createdAt])
  @@map("providers")
}

model Service {
  id                  String    @id @default(cuid())
  name                String    @unique
  slug                String    @unique
  description         String
  detailedDescription String?   @map("detailed_description")
  category            String
  subcategory         String?
  basePrice           Float     @map("base_price")
  minPrice            Float?    @map("min_price")
  maxPrice            Float?    @map("max_price")
  currency            String    @default("INR")
  estimatedDuration   Int       @map("estimated_duration")
  durationRange       String?   @map("duration_range")
  isActive            Boolean   @default(true) @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  isPopular           Boolean   @default(false) @map("is_popular")
  isPromoted          Boolean   @default(false) @map("is_promoted")
  popularity          Int       @default(0)
  bookingCount        Int       @default(0) @map("booking_count")
  icon                String?
  images              String[]
  thumbnail           String?
  includedServices    String[]  @map("included_services")
  excludedServices    String[]  @map("excluded_services")
  requirements        String[]
  availableCities     String[]  @map("available_cities")
  unavailableCities   String[]  @map("unavailable_cities")
  tags                String[]
  seoTitle            String?   @map("seo_title")
  seoDescription      String?   @map("seo_description")
  seoKeywords         String?   @map("seo_keywords")
  pricingModel        String    @default("fixed") @map("pricing_model")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  premiumOnly         Boolean   @default(false) @map("premium_only")
  bookings            Booking[]

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([popularity])
  @@index([slug])
  @@map("services")
}

model Address {
  id                           String               @id @default(cuid())
  userId                       String               @map("user_id")
  label                        String
  addressLine1                 String?              @map("address_line1")
  addressLine2                 String?              @map("address_line2")
  addressLine1Encrypted        String?              @map("address_line1_encrypted")
  addressLine2Encrypted        String?              @map("address_line2_encrypted")
  fullAddress                  String?              @map("full_address")
  fullAddressEncrypted         String?              @map("full_address_encrypted")
  landmark                     String?
  landmarkEncrypted            String?              @map("landmark_encrypted")
  specialInstructions          String?              @map("special_instructions")
  specialInstructionsEncrypted String?              @map("special_instructions_encrypted")
  addressPayloadHash           String?              @map("address_payload_hash")
  encryptionKeyVersion         Int?                 @map("encryption_key_version")
  dataEncryptionStatus         DataEncryptionStatus @default(PARTIAL) @map("data_encryption_status")
  city                         String
  state                        String
  zipCode                      String               @map("zip_code")
  country                      String               @default("India")
  latitude                     Float
  longitude                    Float
  placeId                      String?              @map("place_id")
  type                         String               @default("residential")
  isDefault                    Boolean              @default(false) @map("is_default")
  isBillingAddress             Boolean              @default(false) @map("is_billing_address")
  buildingName                 String?              @map("building_name")
  flatNumber                   String?              @map("flat_number")
  isVerified                   Boolean              @default(false) @map("is_verified")
  verifiedAt                   DateTime?            @map("verified_at")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")
  user                         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings                     Booking[]

  @@index([userId])
  @@index([city])
  @@index([isDefault])
  @@index([addressPayloadHash])
  @@map("addresses")
}

model Booking {
  id                          String                       @id @default(cuid())
  bookingNumber               String                       @unique @map("booking_number")
  userId                      String                       @map("user_id")
  providerId                  String?                      @map("provider_id")
  serviceId                   String                       @map("service_id")
  addressId                   String                       @map("address_id")
  status                      BookingStatus                @default(PENDING)
  scheduledDate               DateTime                     @map("scheduled_date")
  scheduledTime               String?                      @map("scheduled_time")
  acceptedAt                  DateTime?                    @map("accepted_at")
  startedAt                   DateTime?                    @map("started_at")
  completedAt                 DateTime?                    @map("completed_at")
  cancelledAt                 DateTime?                    @map("cancelled_at")
  estimatedDuration           Int?                         @map("estimated_duration")
  actualDuration              Int?                         @map("actual_duration")
  eta                         Int?
  description                 String?
  userNotes                   String?                      @map("user_notes")
  providerNotes               String?                      @map("provider_notes")
  baseAmount                  Float                        @map("base_amount")
  baseAmountPaise             BigInt                       @default(0) @map("base_amount_paise")
  discount                    Float                        @default(0)
  discountPaise               BigInt                       @default(0) @map("discount_paise")
  couponCode                  String?                      @map("coupon_code")
  /// Catalog snapshot of chosen add-ons at booking time: [{id,name,price}]
  addons                      Json?
  taxes                       Float                        @default(0)
  taxesPaise                  BigInt                       @default(0) @map("taxes_paise")
  finalAmount                 Float                        @map("final_amount")
  finalAmountPaise            BigInt                       @default(0) @map("final_amount_paise")
  tipAmount                   Float                        @default(0) @map("tip_amount")
  tipAmountPaise              BigInt                       @default(0) @map("tip_amount_paise")
  totalAmount                 Float                        @map("total_amount")
  totalAmountPaise            BigInt                       @default(0) @map("total_amount_paise")
  paymentStatus               PaymentStatus                @default(PENDING) @map("payment_status")
  paymentMethod               String?                      @map("payment_method")
  cancellationReason          String?                      @map("cancellation_reason")
  cancelledBy                 String?                      @map("cancelled_by")
  refundStatus                String?                      @map("refund_status")
  refundAmount                Float?                       @map("refund_amount")
  refundAmountPaise           BigInt?                      @map("refund_amount_paise")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  assignedAt                  DateTime?                    @map("assigned_at")
  enRouteAt                   DateTime?                    @map("en_route_at")
  arrivedAt                   DateTime?                    @map("arrived_at")
  travelDurationMin           Int?                         @map("travel_duration_min")
  campaignDiscount            Float                        @default(0) @map("campaign_discount")
  campaignDiscountPaise       BigInt                       @default(0) @map("campaign_discount_paise")
  campaignId                  String?                      @map("campaign_id")
  premiumMatched              Boolean                      @default(false) @map("premium_matched")
  priorityServed              Boolean                      @default(false) @map("priority_served")
  queuePosition               Int?                         @map("queue_position")
  queuePriority               QueuePriority                @default(NORMAL) @map("queue_priority")
  queuedAt                    DateTime?                    @map("queued_at")
  waitTimeMs                  BigInt?                      @map("wait_time_ms")
  estimatedWaitTimeMs         BigInt?                      @map("estimated_wait_time_ms")
  priorityScore               Int                          @default(10) @map("priority_score")
  activityLogs                ActivityLog[]
  assignmentJob               AssignmentJob?
  address                     Address                      @relation(fields: [addressId], references: [id])
  campaign                    Campaign?                    @relation(fields: [campaignId], references: [id])
  provider                    Provider?                    @relation(fields: [providerId], references: [id])
  service                     Service                      @relation(fields: [serviceId], references: [id])
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponUsages                CouponUsage[]
  membershipCashbacks         MembershipCashback?
  membershipCouponRedemptions MembershipCouponRedemption[]
  payment                     Payment?
  rating                      Rating?
  supportTickets              SupportTicket[]
  tracking                    Tracking?

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([bookingNumber])
  @@index([userId, createdAt])
  @@index([providerId, status])
  @@index([queuePriority, status])
  @@index([campaignId])
  @@index([status, providerId, priorityScore, queuedAt])
  @@index([addressId])
  @@index([serviceId])
  @@map("bookings")
}

model Payment {
  id                       String              @id @default(cuid())
  bookingId                String              @unique @map("booking_id")
  idempotencyKey           String              @unique @map("idempotency_key")
  userId                   String              @map("user_id")
  amount                   Float
  amountPaise              BigInt              @default(0) @map("amount_paise")
  amountPaid               Float               @default(0) @map("amount_paid")
  amountPaidPaise          BigInt              @default(0) @map("amount_paid_paise")
  currency                 String              @default("INR")
  paymentMethod            String              @map("payment_method")
  razorpayOrderId          String              @unique @map("razorpay_order_id")
  razorpayPaymentId        String?             @unique @map("razorpay_payment_id")
  razorpaySignature        String?             @map("razorpay_signature")
  razorpayErrorCode        String?             @map("razorpay_error_code")
  razorpayErrorDescription String?             @map("razorpay_error_description")
  status                   PaymentStatus       @default(INITIATED)
  refundedAmount           Float               @default(0) @map("refunded_amount")
  refundedAmountPaise      BigInt              @default(0) @map("refunded_amount_paise")
  refundReason             String?             @map("refund_reason")
  razorpayRefundId         String?             @unique @map("razorpay_refund_id")
  refundStatus             String?             @map("refund_status")
  receiptUrl               String?             @map("receipt_url")
  invoiceNumber            String?             @unique @map("invoice_number")
  metadata                 String?
  notes                    String?
  settledAt                DateTime?           @map("settled_at")
  settlementId             String?             @map("settlement_id")
  initiatedAt              DateTime            @default(now()) @map("initiated_at")
  completedAt              DateTime?           @map("completed_at")
  failedAt                 DateTime?           @map("failed_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  settledAmount            Float?              @map("settled_amount")
  settledAmountPaise       BigInt?             @map("settled_amount_paise")
  settlements              PaymentSettlement[]
  booking                  Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@map("payments")
}

model Rating {
  id               String    @id @default(cuid())
  bookingId        String    @unique @map("booking_id")
  userId           String    @map("user_id")
  providerId       String    @map("provider_id")
  stars            Int       @map("rating")
  reviewText       String?   @map("review_text")
  shortReview      String?   @map("short_review")
