enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_USER
  CANCELLED_BY_PROVIDER
  /// Payment was never completed within PAYMENT_PENDING_TTL. Not a cancellation by anyone: the
  /// capacity is released and no party is scored for it.
  EXPIRED
  /// The partner arrived and waited the grace period; the customer did not appear. A capped fee may
  /// be retained (see lib/no-show-policy).
  CUSTOMER_NO_SHOW
  /// The partner did not appear. The customer is made whole and is never charged for it.
  PROVIDER_NO_SHOW
}

enum PaymentStatus {
  PENDING
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  REFUNDING
  /// The payment window closed with no capture. Distinct from FAILED (the gateway declined).
  EXPIRED
}

/// Provider earning settlement on the partner wallet (distinct from booking PaymentStatus).
enum EarningSettlementStatus {
  CREDITED
  REVERSED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum BackgroundCheckStatus {
  NOT_DONE
