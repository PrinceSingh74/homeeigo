// ===== Subscriptions / Membership =====
enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

model MembershipPlan {
  id          String               @id @default(cuid())
  name        String
  tier        String               @default("premium")
  interval    SubscriptionInterval
  price       Int // whole rupees
  currency    String               @default("INR")
  description String?
  isActive    Boolean              @default(true) @map("is_active")
  sortOrder   Int                  @default(0) @map("sort_order")

  benefits      SubscriptionBenefit[]
  subscriptions UserSubscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("membership_plans")
}

model SubscriptionBenefit {
  id        String         @id @default(cuid())
  planId    String         @map("plan_id")
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String
  // Entitlement semantics. `type` null = pure display label (legacy/visual only).
  // When set (e.g. DISCOUNT_PCT, CASHBACK_PCT, PREMIUM_ONLY_ACCESS, PRIORITY_BOOKING,
  // PRIORITY_SUPPORT, FREE_DELIVERY), the EntitlementService enforces it server-side.
  // `value` carries the magnitude (percent for *_PCT; ignored for boolean benefits).
  // `quotaLimit` caps usage per `quotaPeriod` (null = unlimited).
  type        String? @map("type")
  value       Float?  @map("value")
  quotaLimit  Int?    @map("quota_limit")
  quotaPeriod String? @map("quota_period") // MONTH | TOTAL (null = unlimited)
  sortOrder   Int     @default(0) @map("sort_order")

  @@index([planId])
  @@map("subscription_benefits")
}

/// Server-side ledger of quota-limited benefit consumption (e.g. N free
/// premium bookings / month). The single source of truth for remaining quota;
/// the frontend is never trusted. Also powers membership benefit analytics.
model MembershipBenefitUsage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  benefitType String   @map("benefit_type")
  period      String   @map("period") // e.g. "2026-06" for MONTH, "TOTAL" for lifetime
  count       Int      @default(0)
  amount      Float    @default(0) // cumulative value applied (e.g. discount/cashback ₹)
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, benefitType, period])
  @@index([userId])
  @@index([benefitType])
  @@map("membership_benefit_usage")
}

model UserSubscription {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id])
  planId    String             @map("plan_id")
  plan      MembershipPlan     @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?          @map("starts_at")
  expiresAt DateTime?          @map("expires_at")
  autoRenew Boolean            @default(false) @map("auto_renew")
  cancelledAt DateTime?        @map("cancelled_at")
  razorpayOrderId String?      @map("razorpay_order_id")

  invoices SubscriptionInvoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("user_subscriptions")
}

model SubscriptionInvoice {
  id             String           @id @default(cuid())
  subscriptionId String           @map("subscription_id")
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id])
  userId         String           @map("user_id")
  amount         Int
  status         String           @default("paid") // paid | pending
  invoiceNumber  String           @unique @map("invoice_number")
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  periodStart    DateTime         @map("period_start")
  periodEnd      DateTime         @map("period_end")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([subscriptionId])
  @@map("subscription_invoices")
}

// ===== Referral Engine =====
enum ReferralStatus {
  PENDING
  QUALIFIED
  FRAUD_BLOCKED
}

enum CommissionStatus {
  PENDING
  REVIEW
  FROZEN
  APPROVED
  REJECTED
}

enum FraudEventType {
  SIGNUP
  REFERRAL
  BOOKING
  COMMISSION
  WITHDRAWAL
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model ReferralTransaction {
  id          String         @id @default(cuid())
  referrerId  String         @map("referrer_id")
  refereeId   String         @unique @map("referee_id")
  code        String
