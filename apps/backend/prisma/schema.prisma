/// Phase 10 — one AI recommendation about one support ticket, recorded so a human decision can be
/// compared against it afterwards.
///
/// Deliberately NOT a second ticket table. It holds no subject, no body, no customer identity and
/// no money: it references the ticket and records what the intelligence layer concluded, so that
/// "AI suggested" stays distinguishable from "a human did". Without this row there is no way to
/// measure recommendation acceptance or human override, and no audit trail linking an agent's
/// action back to the advice that preceded it.
model SupportAiRecommendation {
  id                  String                     @id @default(cuid())
  ticketId            String                     @map("ticket_id")
  /// Rules version that produced this row, so two recommendations from different logic are distinct.
  rulesVersion        String                     @map("rules_version")
  /// Deterministic identity for one (ticket, rules version, context fingerprint). Enforces dedupe.
  recommendationKey   String                     @unique @map("recommendation_key")
  intent              String?
  sentiment           String?
  /// The model's self-reported number. Never a measured accuracy.
  modelConfidence     Float?                     @map("model_confidence")
  classificationState String                     @map("classification_state")
  usedFallback        Boolean                    @default(false) @map("used_fallback")
  provider            String?
  model               String?
  action              String
  risk                String
  requiresHumanReview Boolean                    @map("requires_human_review")
  /// Lifecycle of this recommendation, not of the ticket.
  lifecycle           SupportRecommendationState @default(RECOMMENDATION)
  /// Set only when a human acted. `actedAction` records what they actually did.
  actedBy             String?                    @map("acted_by")
  actedAt             DateTime?                  @map("acted_at")
  actedAction         String?                    @map("acted_action")
  /// True when the human's action differs from what was recommended.
  overridden          Boolean?
  /// Approval row when the action required one. Never populated by the AI layer itself.
  approvalId          String?                    @map("approval_id")
  failureReason       String?                    @map("failure_reason")
  evidence            Json
  limitations         String[]
  eligibilityChecks   Json                       @map("eligibility_checks")
  automationEligible  Boolean                    @default(false) @map("automation_eligible")
  latencyMs           Int?                       @map("latency_ms")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  ticket              SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([lifecycle])
  @@index([intent])
  @@index([action])
  @@map("support_ai_recommendations")
}

/// Lifecycle of an AI recommendation. Named by the directive; each value means one thing only.
enum SupportRecommendationState {
  /// Produced by the intelligence layer. No human has seen it yet.
  RECOMMENDATION
  /// Carries risk that requires a person before anything happens.
  REVIEW_REQUIRED
  /// A human accepted it. Acceptance is not execution.
  APPROVED
  /// A human rejected it, or acted differently.
  REJECTED
  /// The corresponding action was carried out by an authoritative service.
  EXECUTED
  /// Execution was attempted and failed. `failureReason` says why.
  FAILED
  /// Superseded before anyone acted, because the ticket moved on.
  EXPIRED
}

/// Phase 11 — one version of one piece of official HOMEEIGO knowledge.
///
/// Not a generic document store. A row here is a *governed* artifact: it has a type from a closed
/// taxonomy, a version, an approval state, an owner and an audience. Storage and retrieval
/// eligibility are deliberately separate — a document can exist here and never be retrievable.
model KnowledgeDocument {
  id             String              @id @default(cuid())
  /// Stable identity across versions. Two versions of the Refund Policy share this.
  documentKey    String              @map("document_key")
  version        Int                 @default(1)
  type           KnowledgeType
  title          String
  /// Normalised plain text. The chunker reads this, never the original formatting.
  content        String
  /// SHA-256 of the normalised content. Drives idempotent ingestion and index consistency.
  contentHash    String              @map("content_hash")
  status         KnowledgeStatus     @default(DRAFT)
  /// Who may retrieve it. A partner SOP is not customer knowledge because retrieval found it.
  audience       KnowledgeAudience   @default(INTERNAL)
  /// Where the text came from, so a citation can be traced to a system of record.
  sourceRef      String              @map("source_ref")
  language       String              @default("en")
  owner          String?
  effectiveFrom  DateTime?           @map("effective_from")
  effectiveTo    DateTime?           @map("effective_to")
  approvedBy     String?             @map("approved_by")
  approvedAt     DateTime?           @map("approved_at")
  /// Set when a newer version replaces this one. Never deleted — audit needs the history.
  supersededById String?             @map("superseded_by_id")
  withdrawnAt    DateTime?           @map("withdrawn_at")
  withdrawnBy    String?             @map("withdrawn_by")
  indexState     KnowledgeIndexState @default(NOT_INDEXED) @map("index_state")
  indexError     String?             @map("index_error")
  indexedAt      DateTime?           @map("indexed_at")
  chunkCount     Int                 @default(0) @map("chunk_count")
  embeddingModel String?             @map("embedding_model")
  embeddingDim   Int?                @map("embedding_dim")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  chunks         KnowledgeChunk[]

  @@unique([documentKey, version])
  @@index([type, status])
  @@index([status, audience])
  @@index([contentHash])
  @@map("knowledge_documents")
}

/// One retrievable unit of a knowledge document, with the metadata a citation needs.
model KnowledgeChunk {
  id             String            @id @default(cuid())
  documentId     String            @map("document_id")
  chunkIndex     Int               @map("chunk_index")
  /// The heading this chunk sits under, so a citation can name a section rather than an offset.
  section        String?
  content        String
  /// Character offsets into the document's normalised content. Makes a citation checkable.
  startOffset    Int               @map("start_offset")
  endOffset      Int               @map("end_offset")
  tokenEstimate  Int               @map("token_estimate")
  /// Stored as a plain float array: pgvector is not installed and not available in the running
  /// image. Exact cosine is computed in SQL, which is correct at development corpus size and
  /// honestly does not scale to millions of chunks without an ANN index.
  embedding      Float[]
  embeddingModel String?           @map("embedding_model")
  contentHash    String            @map("content_hash")
  createdAt      DateTime          @default(now()) @map("created_at")
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("knowledge_chunks")
}

/// The seven Phase-11 knowledge classes. One canonical value each; no near-duplicates.
enum KnowledgeType {
  FAQ
  CANCELLATION_POLICY
  REFUND_POLICY
  TERMS
  PARTNER_SOP
  SERVICE_INFORMATION
  TRAINING_DOCUMENT
}

/// Lifecycle. Only APPROVED is retrieval-eligible; every other state is explicitly not.
enum KnowledgeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

/// Who may retrieve. Enforced before retrieval, never by asking the model to ignore things.
enum KnowledgeAudience {
  PUBLIC
  CUSTOMER
  PARTNER
  INTERNAL
}

/// Phase 11 — an administratively-declared precedence between knowledge types.
///
/// The platform ships with this table EMPTY, and that is a deliberate state rather than an
/// oversight. Nothing in HOMEEIGO's legal text, contracts, product docs, config or code declares
/// that (say) Terms outrank an FAQ. Precedence between official documents is a legal and business
/// determination, so the engine models it instead of assuming it: with no row for a type, conflicts
/// resolve to HUMAN_REVIEW_REQUIRED rather than to whichever document a ranking function preferred.
///
/// Rows are versioned and never edited in place — a precedence that governed an answer last month
/// must still be reconstructable, which an UPDATE would destroy.
model KnowledgeAuthorityRule {
  id             String                   @id @default(cuid())
  type           KnowledgeType
  /// Higher wins. The scale is arbitrary and administrator-chosen; only the ordering is meaningful.
  rank           Int
  /// Why this rank. Required: an unexplained precedence is not an auditable governance decision.
  rationale      String
  version        Int                      @default(1)
  status         KnowledgeAuthorityStatus @default(ACTIVE)
  effectiveFrom  DateTime?                @map("effective_from")
  effectiveTo    DateTime?                @map("effective_to")
  createdBy      String                   @map("created_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  supersededById String?                  @map("superseded_by_id")
  revokedAt      DateTime?                @map("revoked_at")
  revokedBy      String?                  @map("revoked_by")
  revokedReason  String?                  @map("revoked_reason")

  @@unique([type, version])
  @@index([type, status])
  /// Partial unique `knowledge_authority_rules_one_active_per_type` on (type) WHERE status = 'ACTIVE'
  /// is created in 20260905090000_knowledge_authority. Prisma schema cannot express the WHERE clause;
  /// `db push` omits it — migrate deploy is required for the invariant.
  @@map("knowledge_authority_rules")
}

/// Lifecycle of a precedence declaration. Only ACTIVE participates in conflict resolution.
enum KnowledgeAuthorityStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum KnowledgeIndexState {
  NOT_INDEXED
  CHUNKED
  EMBEDDED
  INDEXED
  EMBEDDING_FAILED
  INDEX_FAILED
}

model ActivityLog {
  id          String    @id @default(cuid())
