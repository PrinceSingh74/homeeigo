  fraudFlagged Boolean       @default(false) @map("fraud_flagged")
  riskScore   Int?           @map("risk_score")
  qualifiedAt DateTime?      @map("qualified_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  referrer   User                @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Restrict)
  referee    User                @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Restrict)
  commission ReferralCommission?
  fraudAlerts FraudAlert[]

  @@index([referrerId])
  @@index([status])
  @@index([fraudFlagged])
  @@map("referral_transactions")
}

model ReferralCommission {
  id            String           @id @default(cuid())
  referrerId    String           @map("referrer_id")
  refereeId     String           @map("referee_id")
  transactionId String           @unique @map("transaction_id")
  bookingId     String           @map("booking_id")
  amount        Int
  status        CommissionStatus @default(PENDING)
  riskScore     Int?             @map("risk_score")
  frozenAt      DateTime?        @map("frozen_at")
  reviewedBy    String?          @map("reviewed_by")
  reviewedAt    DateTime?        @map("reviewed_at")
  releasedAt    DateTime?        @map("released_at")
  rejectReason  String?          @map("reject_reason")
  createdAt     DateTime         @default(now()) @map("created_at")

  referrer    User                @relation("RefCommissionEarned", fields: [referrerId], references: [id], onDelete: Restrict)
  transaction ReferralTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fraudAlerts FraudAlert[]

  @@index([referrerId])
  @@index([status])
  @@map("referral_commissions")
}

model ReferralWithdrawal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  status    String   @default("completed")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("referral_withdrawals")
}

