  ARRIVED
  IN_PROGRESS
  COMPLETED
}

enum WalletTxnType {
  CREDIT
  DEBIT
  BONUS
  REFUND
  WITHDRAWAL
  REVERSAL
}

enum WalletTxnStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  REVERSED
}

enum WithdrawalStatus {
