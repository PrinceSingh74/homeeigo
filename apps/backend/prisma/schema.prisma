model LedgerEntry {
  id        String        @id @default(cuid())
  journalId String        @map("journal_id")
  journal   JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  accountId String        @map("account_id")
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Float         @default(0)
  credit    Float         @default(0)
  currency  String        @default("INR")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([journalId])
  @@index([accountId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ─── Enterprise Finance Core (Phases 3–8) ───────────────────────────────────

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  MISSING_LOCAL
  MISSING_GATEWAY
  REFUND_MISMATCH
  SETTLEMENT_MISMATCH
}

enum FinancialRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PaymentSettlement {
  id                String           @id @default(cuid())
  paymentId         String           @map("payment_id")
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  settlementBatchId String?          @map("settlement_batch_id")
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id], onDelete: SetNull)
  razorpayPaymentId String?          @map("razorpay_payment_id")
  settlementId      String           @map("settlement_id")
  settledAmount     Float            @map("settled_amount")
  settledAt         DateTime         @map("settled_at")
  gatewayReference  String?          @map("gateway_reference")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([paymentId, settlementId])
  @@index([settlementId])
  @@index([settledAt])
  @@map("payment_settlements")
}

model SettlementLineItem {
  id                String          @id @default(cuid())
  settlementBatchId String          @map("settlement_batch_id")
  settlementBatch   SettlementBatch @relation(fields: [settlementBatchId], references: [id], onDelete: Cascade)
  paymentId         String?         @map("payment_id")
  razorpayPaymentId String?         @map("razorpay_payment_id")
  amount            Float
  fee               Float           @default(0)
  tax               Float           @default(0)
  netAmount         Float           @map("net_amount")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([settlementBatchId])
  @@index([paymentId])
  @@map("settlement_line_items")
}

model PaymentReconciliation {
  id             String               @id @default(cuid())
  runDate        DateTime             @default(now()) @map("run_date")
  status         ReconciliationStatus @default(MATCHED)
  matchedCount   Int                  @default(0) @map("matched_count")
  mismatchCount  Int                  @default(0) @map("mismatch_count")
  missingLocal   Int                  @default(0) @map("missing_local")
  missingGateway Int                  @default(0) @map("missing_gateway")
  matchPct       Float                @default(100) @map("match_pct")
  metadata       String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at")

  issues ReconciliationIssue[]

  @@index([runDate])
  @@index([status])
  @@map("payment_reconciliations")
}

model ReconciliationIssue {
  id               String               @id @default(cuid())
  reconciliationId String               @map("reconciliation_id")
  reconciliation   PaymentReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  issueType        ReconciliationStatus @map("issue_type")
  referenceId      String?              @map("reference_id")
  referenceType    String?              @map("reference_type")
  expectedAmount   Float?               @map("expected_amount")
  actualAmount     Float?               @map("actual_amount")
  details          String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([reconciliationId])
  @@index([issueType])
  @@map("reconciliation_issues")
}

model LedgerBalanceSnapshot {
  id        String        @id @default(cuid())
  journalId String        @map("journal_id")
  journal   JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  accountId String        @map("account_id")
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  balance   Float
  currency  String        @default("INR")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([journalId, accountId])
  @@index([accountId])
  @@map("ledger_balance_snapshots")
}

model PayoutAttempt {
  id               String     @id @default(cuid())
  withdrawalId     String     @map("withdrawal_id")
  withdrawal       Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  attemptNo        Int        @map("attempt_no")
  status           String
  razorpayPayoutId String?    @map("razorpay_payout_id")
  failureReason    String?    @map("failure_reason") @db.Text
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([withdrawalId])
  @@map("payout_attempts")
}

model ChargebackEvidence {
  id           String     @id @default(cuid())
  chargebackId String     @map("chargeback_id")
  chargeback   Chargeback @relation(fields: [chargebackId], references: [id], onDelete: Cascade)
  storageKey   String     @unique @map("storage_key")
  fileName     String     @map("file_name")
  mimeType     String     @default("application/octet-stream") @map("mime_type")
  fileUrl      String?    @map("file_url") @db.Text
  description  String?    @db.Text
  uploadedBy   String?    @map("uploaded_by")
  createdAt    DateTime   @default(now()) @map("created_at")

  downloadTokens ChargebackEvidenceDownloadToken[]

  @@index([chargebackId])
  @@map("chargeback_evidence")
}

model ChargebackEvidenceDownloadToken {
  id         String             @id @default(cuid())
  evidenceId String             @map("evidence_id")
  evidence   ChargebackEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  token      String             @unique
  adminId    String             @map("admin_id")
  expiresAt  DateTime           @map("expires_at")
  usedAt     DateTime?          @map("used_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([evidenceId])
  @@index([expiresAt])
  @@map("chargeback_evidence_download_tokens")
}

model ChargebackTimeline {
  id           String     @id @default(cuid())
  chargebackId String     @map("chargeback_id")
  chargeback   Chargeback @relation(fields: [chargebackId], references: [id], onDelete: Cascade)
  action       String
  details      String?    @db.Text
  actorId      String?    @map("actor_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([chargebackId])
  @@map("chargeback_timeline")
}

model FinancialRiskEvent {
  id            String             @id @default(cuid())
  userId        String?            @map("user_id")
  eventType     String             @map("event_type")
  severity      FinancialRiskLevel
  referenceId   String?            @map("reference_id")
  referenceType String?            @map("reference_type")
  metadata      String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@map("financial_risk_events")
}

model FinancialFraudCase {
  id          String             @id @default(cuid())
  userId      String?            @map("user_id")
  category    String
  severity    FinancialRiskLevel
  status      String             @default("OPEN")
  title       String
  description String             @db.Text
  metadata    String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([category])
  @@index([status])
  @@map("financial_fraud_cases")
}

// ─── Finance Operations Finalization (Phases 1–7) ───────────────────────────

enum MigrationVerificationStatus {
  PASS
  FAIL
}

enum SettlementSyncStatus {
  STARTED
  COMPLETED
  FAILED
}

enum SettlementDiscrepancyType {
  MISSING_PAYMENT
  AMOUNT_MISMATCH
  DUPLICATE_SETTLEMENT
  UNKNOWN_SETTLEMENT
}

enum FinancialIntegrityStatus {
  PASS
  FAIL
}

enum FinanceAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MigrationVerificationRun {
  id              String                      @id @default(cuid())
  status          MigrationVerificationStatus
  appliedCount    Int                         @default(0) @map("applied_count")
  pendingCount    Int                         @default(0) @map("pending_count")
  failedCount     Int                         @default(0) @map("failed_count")
  driftDetected   Boolean                     @default(false) @map("drift_detected")
  rollbackRisk    Boolean                     @default(false) @map("rollback_risk")
  schemaChecksum  String                      @map("schema_checksum")
  report          String                      @db.Text
  createdAt       DateTime                    @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("migration_verification_runs")
}

model SettlementSyncRun {
  id                  String               @id @default(cuid())
  status              SettlementSyncStatus @default(STARTED)
  settlementsSynced   Int                  @default(0) @map("settlements_synced")
  discrepanciesFound  Int                  @default(0) @map("discrepancies_found")
  accuracyPct         Float?               @map("accuracy_pct")
  errorMessage        String?              @map("error_message") @db.Text
  startedAt           DateTime             @default(now()) @map("started_at")
  completedAt         DateTime?            @map("completed_at")

  discrepancies SettlementDiscrepancy[]

  @@index([status])
  @@index([startedAt])
  @@map("settlement_sync_runs")
}

model SettlementDiscrepancy {
  id             String                    @id @default(cuid())
  syncRunId      String                    @map("sync_run_id")
  syncRun        SettlementSyncRun         @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  type           SettlementDiscrepancyType
  referenceId    String?                   @map("reference_id")
  expectedAmount Float?                    @map("expected_amount")
  actualAmount   Float?                    @map("actual_amount")
  resolved       Boolean                   @default(false)
  resolvedAt     DateTime?                 @map("resolved_at")
  resolvedBy     String?                   @map("resolved_by")
  details        String?                   @db.Text
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@index([syncRunId])
  @@index([type])
  @@index([resolved])
  @@map("settlement_discrepancies")
}

model FinancialIntegrityRun {
  id          String                   @id @default(cuid())
  status      FinancialIntegrityStatus
  issuesCount Int                      @default(0) @map("issues_count")
  report      String                   @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("financial_integrity_runs")
}

model FinanceAlert {
  id        String               @id @default(cuid())
  alertType String               @map("alert_type")
  severity  FinanceAlertSeverity
  message   String               @db.Text
  metadata  String?              @db.Text
  resolved  Boolean              @default(false)
  createdAt DateTime             @default(now()) @map("created_at")
  resolvedAt DateTime?           @map("resolved_at")

  @@index([alertType])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("finance_alerts")
}

// ─── Finance Operations 10/10 Finalization ──────────────────────────────────

enum RefundRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REFUNDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PartnerRegistrationSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum WalletReservationStatus {
  RESERVED
  RELEASED
  CONSUMED
}

enum PayoutBatchStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

model GatewayReconciliationRun {
  id                       String   @id @default(cuid())
  runDate                  DateTime @default(now()) @map("run_date")
  matchedCount             Int      @default(0) @map("matched_count")
  mismatchCount            Int      @default(0) @map("mismatch_count")
  missingLocal             Int      @default(0) @map("missing_local")
  missingGateway           Int      @default(0) @map("missing_gateway")
  matchPct                 Float    @default(100) @map("match_pct")
  gatewayPaymentsFetched   Int      @default(0) @map("gateway_payments_fetched")
  gatewayRefundsFetched    Int      @default(0) @map("gateway_refunds_fetched")
  gatewaySettlementsFetched Int     @default(0) @map("gateway_settlements_fetched")
  report                   String   @db.Text
  createdAt                DateTime @default(now()) @map("created_at")

  issues GatewayReconciliationIssue[]

  @@index([runDate])
  @@map("gateway_reconciliation_runs")
}

model GatewayReconciliationIssue {
  id                 String               @id @default(cuid())
  runId              String               @map("run_id")
  run                GatewayReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  issueType          ReconciliationStatus @map("issue_type")
  gatewayReference   String?              @map("gateway_reference")
  localReference     String?              @map("local_reference")
  expectedAmount     Float?               @map("expected_amount")
  actualAmount       Float?               @map("actual_amount")
  details            String?              @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([runId])
  @@index([issueType])
  @@map("gateway_reconciliation_issues")
}

model PayoutBatch {
  id          String            @id @default(cuid())
  batchNumber String            @unique @map("batch_number")
  status      PayoutBatchStatus @default(DRAFT)
  totalAmount Float             @default(0) @map("total_amount")
  itemCount   Int               @default(0) @map("item_count")
  processedBy String?           @map("processed_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")

  items            PayoutBatchItem[]
  reconciliations  PayoutReconciliation[]

  @@index([status])
  @@index([createdAt])
  @@map("payout_batches")
}

model PayoutBatchItem {
  id           String      @id @default(cuid())
  batchId      String      @map("batch_id")
  batch        PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  withdrawalId String      @map("withdrawal_id")
  amount       Float
  status       String      @default("PENDING")
  failureReason String?    @map("failure_reason") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")

  @@unique([batchId, withdrawalId])
  @@index([withdrawalId])
  @@map("payout_batch_items")
}

model PayoutReconciliation {
  id         String       @id @default(cuid())
  batchId    String?      @map("batch_id")
  batch      PayoutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  runDate    DateTime     @default(now()) @map("run_date")
  matched    Int          @default(0)
  mismatched Int          @default(0)
  report     String       @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([batchId])
  @@map("payout_reconciliations")
}

model RefundRequest {
  id               String              @id @default(cuid())
  paymentId        String              @map("payment_id")
  userId           String              @map("user_id")
  amount           Float
  reason           String              @db.Text
  reasonCode       String?             @map("reason_code")
  status           RefundRequestStatus @default(REQUESTED)
  requestedBy      String              @map("requested_by")
  reviewedBy       String?             @map("reviewed_by")
  reviewNotes      String?             @map("review_notes") @db.Text
  idempotencyKey   String              @unique @map("idempotency_key")
  gatewayRefundId  String?             @unique @map("gateway_refund_id")
  razorpayRefundId String?             @map("razorpay_refund_id")
  processedAt      DateTime?           @map("processed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  audits RefundAudit[]

  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@map("refund_requests")
}

model PartnerRegistrationSession {
  id          String                           @id @default(cuid())
  userId      String                           @unique @map("user_id")
  user        User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String?                          @map("provider_id")
  otpVerified Boolean                          @default(false) @map("otp_verified")
  expiresAt   DateTime                         @map("expires_at")
  status      PartnerRegistrationSessionStatus @default(ACTIVE)
  createdAt   DateTime                         @default(now()) @map("created_at")
  updatedAt   DateTime                         @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([expiresAt])
  @@index([status])
  @@map("partner_registration_sessions")
}

model ProviderWalletReservation {
  id           String                  @id @default(cuid())
  providerId   String                  @map("provider_id")
  provider     Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  withdrawalId String                  @unique @map("withdrawal_id")
  amount       Float
  status       WalletReservationStatus @default(RESERVED)
  createdAt    DateTime                @default(now()) @map("created_at")
  releasedAt   DateTime?               @map("released_at")
  consumedAt   DateTime?               @map("consumed_at")

  @@index([providerId])
  @@index([status])
  @@map("provider_wallet_reservations")
}

model RefundAudit {
  id              String        @id @default(cuid())
  refundRequestId String        @map("refund_request_id")
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  action          String
  actorId         String?       @map("actor_id")
  details         String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([refundRequestId])
  @@map("refund_audits")
}

model FinancialHold {
  id                 String    @id @default(cuid())
  userId             String?   @unique @map("user_id")
  providerId         String?   @unique @map("provider_id")
  walletFrozen       Boolean   @default(false) @map("wallet_frozen")
  withdrawalsFrozen  Boolean   @default(false) @map("withdrawals_frozen")
  payoutsFrozen      Boolean   @default(false) @map("payouts_frozen")
  reason             String    @db.Text
  caseId             String?   @map("case_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  liftedAt           DateTime? @map("lifted_at")

  @@index([userId])
  @@index([providerId])
  @@map("financial_holds")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookEventDedup {
  id              String             @id @default(cuid())
  eventId         String             @unique @map("event_id")
  gatewayEventId  String?            @map("gateway_event_id")
  eventType       String             @map("event_type")
  status          WebhookEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  processedAt     DateTime           @default(now()) @map("processed_at")
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([eventType])
  @@index([status])
  @@map("webhook_event_dedup")
}

// ─── Enterprise Observability ────────────────────────────────────────────────

enum OpsAlertSeverity {
  INFO
  WARNING
  CRITICAL
  ESCALATION
}

model OpsAlert {
  id         String           @id @default(cuid())
  alertType  String           @map("alert_type")
  severity   OpsAlertSeverity
  message    String           @db.Text
  metadata   String?          @db.Text
  resolved   Boolean          @default(false)
  createdAt  DateTime         @default(now()) @map("created_at")
  resolvedAt DateTime?        @map("resolved_at")

  @@index([alertType])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("ops_alerts")
}

enum AppLogCategory {
  APPLICATION
  WEBHOOK
  PAYMENT
  AUDIT
  SECURITY
  FRAUD
  FINANCE
  BOOKING
  PROVIDER
}

model AppLogEntry {
  id        String         @id @default(cuid())
  level     String
  category  AppLogCategory @default(APPLICATION)
  message   String         @db.Text
  requestId String?        @map("request_id")
  traceId   String?        @map("trace_id")
  userId    String?        @map("user_id")
  bookingId String?        @map("booking_id")
  paymentId String?        @map("payment_id")
  metadata  String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@index([traceId])
  @@index([userId])
  @@index([bookingId])
  @@index([paymentId])
  @@index([category])
  @@index([level])
  @@index([createdAt])
  @@map("app_log_entries")
}
