/// How often a service is expected to recur, as declared by a named human.
///
/// This is the one input maintenance intelligence cannot derive. The platform holds 125 completed
/// bookings across a 71-day window, where 61% of repeat gaps are under a day — nothing in that data
/// says an AC service recurs every six months, and a quarterly or annual interval cannot even be
/// observed in a window shorter than two cycles. So the interval is a business assertion, and this
/// table exists to make it one somebody signed for rather than one the code assumed.
///
/// Rows are never created by seeds, migrations or inference. `createdBy` is a `users.id` with the
/// ADMIN role, and a policy with no owner is a policy nobody can be asked about.
/// An image a customer submitted for analysis, and what became of it.
///
/// The row is the record; the bytes live in object storage under `storage_key` and are deleted on
/// their own schedule. Keeping them apart is what lets retention delete the picture while leaving a
/// traceable account of the request behind — an analysis nobody can later explain is worse than one
/// whose source image has expired.
///
/// `retention_until` is set at upload from configuration, never open-ended. `status` moves
/// PENDING -> ANALYZED (or FAILED), then PURGED once the bytes are gone.
model VisionImage {
  id             String             @id @default(cuid())
  ownerId        String             @map("owner_id")
  /// Why this image was submitted. Scopes what the analysis is allowed to be used for.
  purpose        VisionImagePurpose
  storageKey     String             @map("storage_key")
  mimeType       String             @map("mime_type")
  byteSize       Int                @map("byte_size")
  /// SHA-256 of the bytes, so a re-upload is recognisable without keeping a second copy.
  contentHash    String             @map("content_hash")
  status         VisionImageStatus  @default(PENDING)
  retentionUntil DateTime           @map("retention_until")
  purgedAt       DateTime?          @map("purged_at")
  bookingId      String?            @map("booking_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  analyses       VisionAnalysis[]

  @@index([ownerId, createdAt])
  @@index([status, retentionUntil])
  @@map("vision_images")
}

/// What a vision provider said about one image, in a shape the product can act on.
///
/// `observation_mode` is the field that keeps this honest. No AI credentials are configured in this
/// environment, so the provider layer answers from a deterministic mock; a result produced that way
/// is recorded as FALLBACK and must never be presented, reported or certified as a real model
/// observation. The distinction is stored rather than re-derived from config at read time, because
/// config changes and a historical result must keep meaning what it meant when it was made.
model VisionAnalysis {
  id                   String                @id @default(cuid())
  imageId              String                @map("image_id")
  observationMode      VisionObservationMode @map("observation_mode")
  provider             String
  model                String
  observedCategory     String?               @map("observed_category")
  observations         String[]
  /// 0..1. Never invented: a FALLBACK result carries the mock's own fixed confidence, not a guess.
  confidence           Float
  recommendedServiceId String?               @map("recommended_service_id")
  safetyFlags          String[]              @map("safety_flags")
  /// Advisory only. Nothing downstream may treat this as authorisation for money or state changes.
  advisory             Boolean               @default(true)
  latencyMs            Int                   @map("latency_ms")
  createdAt            DateTime              @default(now()) @map("created_at")
  image                VisionImage           @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId, createdAt])
  @@index([observationMode, createdAt])
  @@map("vision_analyses")
}

enum VisionImagePurpose {
  ISSUE_REPORT
  SERVICE_CONTEXT
  SUPPORT_ATTACHMENT
}

enum VisionImageStatus {
  PENDING
  ANALYZED
  FAILED
  PURGED
}

enum VisionObservationMode {
  REAL_PROVIDER
  FALLBACK
}

model ServiceIntervalPolicy {
  id            String                @id @default(cuid())
  serviceId     String                @map("service_id")
  /// DAY | WEEK | MONTH — stored as a unit plus a count rather than raw days, so "every 6 months"
  /// survives as the thing the operator actually said instead of being flattened to 180.
  intervalUnit  ServiceIntervalUnit   @map("interval_unit")
  intervalValue Int                   @map("interval_value")
  effectiveFrom DateTime              @map("effective_from")
  effectiveTo   DateTime?             @map("effective_to")
  /// Where the number came from: MANUFACTURER, OPERATOR, REGULATORY, VENDOR_GUIDANCE.
  source        ServiceIntervalSource
  sourceNote    String?               @map("source_note")
  status        ServiceIntervalStatus @default(DRAFT)
  /// Bumped on every change; superseded rows are kept so a past due-date can still be explained.
  version       Int                   @default(1)
  createdBy     String                @map("created_by")
  updatedBy     String?               @map("updated_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  service       Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// One ACTIVE version per service at a time is enforced in the service layer, not here: a partial
  /// unique index cannot express "active and within its effective window".
  @@unique([serviceId, version])
  @@index([serviceId, status])
  @@index([status, effectiveFrom])
  @@map("service_interval_policies")
}

enum ServiceIntervalUnit {
  DAY
  WEEK
  MONTH
}

enum ServiceIntervalSource {
  MANUFACTURER
  OPERATOR
  REGULATORY
  VENDOR_GUIDANCE
}

enum ServiceIntervalStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

