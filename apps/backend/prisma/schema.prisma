model AiToolPolicyLog {
  id            String               @id @default(cuid())
  toolId        String               @map("tool_id")
  actorId       String?              @map("actor_id")
  actorRole     AiGatewayRole        @map("actor_role")
  decision      AiToolPolicyDecision
  reason        String?
  ruleMatched   String?              @map("rule_matched")
  /// Phase 14 — the ruleset this decision was made under.
  ///
  /// `ruleMatched` names a rule; it does not say what that rule DID at the time. The rules are
  /// code, so editing one silently changes the meaning of every historical row that names it —
  /// a decision logged as "rbac.role_check DENY" becomes unreadable once the roles inside that
  /// check have moved on. The version pins the row to a ruleset whose content is reconstructable.
  ///
  /// Nullable because rows written before this existed genuinely have no version, and
  /// backfilling them with the current one would assert something untrue about the past.
  policyVersion String?              @map("policy_version")
  traceId       String?              @map("trace_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([toolId, createdAt])
  @@index([decision, createdAt])
  @@map("ai_tool_policy_logs")
}

// ── Phase 6A: Automation Workflow Engine ────────────────────────────────────
//
// Workflows are DEFINED IN CODE and SNAPSHOTTED here on activation. Definitions stay typed,
// reviewable and version-controlled; the database row is the immutable record of what a given
// version actually was, which is what lets a running instance be pinned to it. Nothing here is
// executable — a row can never introduce new behaviour, only describe behaviour that already
// exists in code.

enum WorkflowStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum WorkflowInstanceStatus {
  PENDING
  RUNNING
  /// Parked until `nextRunAt`, with a ScheduledJob already queued to wake it.
  WAITING
  SCHEDULED
  PAUSED
  COMPLETED
  /// Ended deliberately without completing — its concern resolved itself, or a guard stopped it.
  SKIPPED
  FAILED
  CANCELLED
}

enum WorkflowStepType {
  WAIT
  CONDITION
  ACTION
  NOTIFICATION
  ESCALATION
  STOP
}

/// One activated version of one workflow. Immutable once `status` leaves DRAFT.
model WorkflowDefinition {
  id                  String                      @id @default(cuid())
  workflowId          String                      @map("workflow_id")
  version             Int
  name                String
  status              WorkflowStatus              @default(DRAFT)
  /// Event type that starts this workflow, e.g. "homigo.payment.failed".
  trigger             String
  /// Frozen copy of the code-defined steps, for audit and for pinning running instances.
  steps               Json
  /// Guards against immortal instances. Both are enforced by the step executor.
  maxAgeMs            Int                         @map("max_age_ms")
  maxSteps            Int                         @map("max_steps")
  /// Snapshot of the code-defined mode. Selects an approved behaviour; never introduces one.
  executionMode       WorkflowExecutionMode       @default(LIVE) @map("execution_mode")
  /// Phase 6G lifecycle. Legacy definitions stay DRAFT and are unaffected by the certification gate.
  certificationStatus WorkflowCertificationStatus @default(DRAFT) @map("certification_status")
  /// Present only on Phase-6G business automations. Its absence is what marks a definition legacy.
  riskClass           WorkflowRiskClass?          @map("risk_class")
  /// Set when the version is activated; its presence is what makes the row immutable.
  activatedAt         DateTime?                   @map("activated_at")
  metadata            Json?
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@unique([workflowId, version])
  @@index([workflowId, status])
  @@index([trigger, status])
  @@map("workflow_definitions")
}

/// One run of one workflow against one subject.
model WorkflowInstance {
  id              String                 @id @default(cuid())
  workflowId      String                 @map("workflow_id")
  /// Pinned at creation. A version activated later never moves a running instance.
  workflowVersion Int                    @map("workflow_version")
  /// Pinned at creation, exactly like the version. Re-publishing a definition as LIVE must not
  /// quietly turn a rehearsal that is already running into a real one.
  executionMode   WorkflowExecutionMode  @default(LIVE) @map("execution_mode")
  /// Polymorphic reference rather than copied data — PII is read at action time, never stored here.
  subjectType     String                 @map("subject_type")
  subjectId       String                 @map("subject_id")
  status          WorkflowInstanceStatus @default(PENDING)
  currentStepId   String?                @map("current_step_id")
  stepIndex       Int                    @default(0) @map("step_index")
  /// Counts every step actually executed, so `maxSteps` can stop a loop that keeps advancing.
  stepCount       Int                    @default(0) @map("step_count")
  nextRunAt       DateTime?              @map("next_run_at")
  triggerEventId  String?                @map("trigger_event_id")
  /// workflowId + version + subject + trigger. A duplicate trigger cannot open a second instance.
  idempotencyKey  String                 @unique @map("idempotency_key")
  traceId         String?                @map("trace_id")
  correlationId   String?                @map("correlation_id")
  reasonCode      String?                @map("reason_code")
  failureReason   String?                @map("failure_reason")
  metadata        Json?
  startedAt       DateTime?              @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  stepRuns WorkflowStepRun[]

  @@index([workflowId, status])
  @@index([status, nextRunAt])
  @@index([subjectType, subjectId])
  @@map("workflow_instances")
}

/// Per-step audit. Answers "what did this instance do, and why" one row at a time.
model WorkflowStepRun {
  id         String           @id @default(cuid())
  instanceId String           @map("instance_id")
  stepId     String           @map("step_id")
  stepIndex  Int              @map("step_index")
  stepType   WorkflowStepType @map("step_type")
  /// FIRED | SKIPPED | CONDITION_FAILED | STALE | ERROR | ...
  outcome    String
  reasonCode String?          @map("reason_code")
  reasonText String?          @map("reason_text")
  attempt    Int              @default(1)
  jobId      String?          @map("job_id")
  durationMs Int?             @map("duration_ms")
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, stepIndex])
  @@index([outcome, createdAt])
  @@map("workflow_step_runs")
}

// ── Phase 6E': Notification Platform ────────────────────────────────────────
//
// One control point for outbound communication. Templates are code-defined and snapshotted here
// exactly as workflow definitions are, so a database row can describe a message but never
// introduce one. Preferences and deliveries are separate concerns from `EmailLog`, which stays
// email-specific.

enum NotificationChannel {
  /// The in-app inbox: a persistent Notification row plus the live WebSocket envelope.
  /// Needs no device and no address — only a valid recipient — which is why it is listed first.
  IN_APP
  PUSH
  EMAIL
  SMS
}

/// Governs whether a recipient may switch a notification off.
enum NotificationCategory {
  /// Booking, payment, service state. The recipient needs these to use the product.
  TRANSACTIONAL
  /// Authentication and account safety. Never optional.
  SECURITY
  /// Promotions, re-engagement, marketing. Freely disabled by the recipient.
  OPTIONAL
}

enum NotificationTemplateStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

/// Deliberately conservative — never claim more than the provider actually confirms.
enum NotificationDeliveryStatus {
  /// Claimed but not yet attempted. The row exists so that concurrent callers sharing an
  /// idempotency key collide on the unique index instead of all reaching the provider.
  PENDING
  /// Handed to the provider; acceptance confirmed, receipt not.
  QUEUED
  /// Provider confirmed it sent the message.
  SENT
  /// Provider confirmed the recipient received it. Only where the provider truly reports this.
  DELIVERED
  FAILED
  /// No usable channel target — no device token, no email, no phone.
  UNAVAILABLE
  /// Deliberately not sent: preference opted out, no template, policy refused.
  SKIPPED
}

/// One activated version of one message, for one channel and language.
model NotificationTemplate {
  id               String                     @id @default(cuid())
  templateId       String                     @map("template_id")
  version          Int
  notificationType String                     @map("notification_type")
  category         NotificationCategory
  channel          NotificationChannel
  language         String                     @default("en")
  status           NotificationTemplateStatus @default(DRAFT)
  /// Null for channels without one (SMS, push body-only).
  title            String?
  body             String
  /// Declared variable names and types. Anything not listed here is rejected at render time.
  variablesSchema  Json                       @map("variables_schema")
  activatedAt      DateTime?                  @map("activated_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@unique([templateId, version])
  @@index([notificationType, channel, language, status])
  @@map("notification_templates")
}

/// A recipient's stated choice. Absence means "use the default", never "off".
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean              @default(true)
  language  String?
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([userId, channel, category])
  @@index([userId])
  @@map("notification_preferences")
}

/// Audit for every routed notification — including the ones deliberately not sent.
///
/// Separate from `EmailLog`, which is email-specific and carries no channel, template version,
/// trace or reason. Holds identifiers and outcomes, never message bodies or recipient contact
/// details: the audit explains a decision, it does not reproduce the message.
model NotificationDelivery {
  id               String                     @id @default(cuid())
  notificationId   String                     @unique @map("notification_id")
  recipientType    String                     @map("recipient_type")
  recipientId      String                     @map("recipient_id")
  notificationType String                     @map("notification_type")
  category         NotificationCategory
  channel          NotificationChannel
  templateId       String?                    @map("template_id")
  templateVersion  Int?                       @map("template_version")
  language         String?
  status           NotificationDeliveryStatus
  reasonCode       String?                    @map("reason_code")
  /// Provider's own id, where it returns one safely. Never a raw provider payload.
  providerRef      String?                    @map("provider_ref")
  /// Stable operation identity. A repeat of the same request resolves to this row.
  idempotencyKey   String                     @unique @map("idempotency_key")
  traceId          String?                    @map("trace_id")
  correlationId    String?                    @map("correlation_id")
  sentAt           DateTime?                  @map("sent_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  /// Doubles as the claim lease while the row is PENDING.
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@index([recipientType, recipientId, createdAt])
  @@index([status, createdAt])
  @@index([notificationType, createdAt])
  @@map("notification_deliveries")
}

/// Phase 6G — how far a business automation has travelled from idea to permission.
///
/// Deliberately separate from `WorkflowStatus`, which answers "is this version published". This
/// answers "has anyone reviewed what it would do". A version can be published and uncertified, and
/// that combination must stay expressible — it is the normal state of a rehearsal.
enum WorkflowCertificationStatus {
  DRAFT
  SHADOW
  CERTIFIED
  DISABLED
  DEPRECATED
}

/// Phase 6G — how much damage a business automation could do if it were wrong.
enum WorkflowRiskClass {
  LOW
  MEDIUM
  HIGH
}

/// Phase 6G — a standing statement that one workflow version was reviewed and may act for real.
///
/// Not `AiToolApproval`. That binds a tool, a requester and an arguments hash, and is consumed once
/// for a single execution; this is a durable fact about a version. Sharing the model would let a
/// business certification be spent like a financial approval, which is the confusion Phase 5 was
/// built to prevent.
model AutomationCertification {
  id                      String                @id @default(cuid())
  automationId            String                @map("automation_id")
  workflowVersion         Int                   @map("workflow_version")
  certifiedAt             DateTime              @default(now()) @map("certified_at")
  /// The human who took responsibility. Never a service account.
  certifiedBy             String                @map("certified_by")
  approvalReference       String?               @map("approval_reference")
  /// Where the rehearsal evidence lives — a query, a document, a run id.
  shadowEvidenceReference String?               @map("shadow_evidence_reference")
  testEvidenceReference   String?               @map("test_evidence_reference")
  riskClass               WorkflowRiskClass     @map("risk_class")
  /// What this certification does NOT cover. Empty is a claim in itself.
  knownLimitations        String?               @map("known_limitations")
  approvedExecutionMode   WorkflowExecutionMode @default(SHADOW) @map("approved_execution_mode")
  /// The admin whose authorization created this row, resolved against users at write time.
  /// Null on rows written before authorization was enforced — those are the incident's evidence.
  approvedByAdminId       String?               @map("approved_by_admin_id")
  /// What the engine could actually execute when this was signed. A certification approves a
  /// workflow running on a particular engine, not the workflow alone: if ESCALATION becomes
  /// implemented later, the same version acquires powers nobody signed for. A mismatch fails closed.
  capabilityFingerprint   String?               @map("capability_fingerprint")
  /// Set when a certification is withdrawn. The row is never deleted — a voided certification is
  /// the record that someone once claimed this was approved, which is exactly what an audit needs.
  voidedAt                DateTime?             @map("voided_at")
  voidedBy                String?               @map("voided_by")
  voidReason              String?               @map("void_reason")
  createdAt               DateTime              @default(now()) @map("created_at")

  @@unique([automationId, workflowVersion], map: "automation_certifications_automation_version_key")
  @@index([automationId, certifiedAt])
  @@map("automation_certifications")
}

/// Phase 6D — whether a workflow really acts, or only works out what it would have done.
///
/// Two values and no more. A stored mode selects between behaviours that already exist in code; it
/// can never introduce one, which is the same rule Phase 6A applies to step definitions.
enum WorkflowExecutionMode {
  LIVE
  SHADOW
}

/// Phase 6G-C — whether a rehearsal came from a test run or from real traffic.
///
/// Nothing in production has ever deleted a shadow row; the table only ever emptied because every
/// row in it was written by a test that tidied up after itself. This marker is what stops that
/// happening once real observations exist — cleanup scopes to TEST, and anything unmarked is kept.
///
/// It is set from the execution context, never from a request, and it must not influence a single
/// decision. A caller able to declare its own run a test could arrange for its evidence to vanish.
enum ShadowEvidenceSource {
  TEST
  OBSERVATION
}

/// Phase 6D — what a shadow workflow would have done, and proof that it did not do it.
///
/// Deliberately its own table rather than rows inside `NotificationDecisionAudit`. Every existing
/// reader of that table — the decision/created_at index, any suppression-rate report built on it —
/// would otherwise start counting rehearsals as real decisions, and nothing in the row would say
/// otherwise. Live decision history stays live truth; comparison is a join, not a shared table.
model AutomationShadowExecution {
  id                  String                @id @default(cuid())
  shadowExecutionId   String                @unique(map: "automation_shadow_executions_execution_id_key") @map("shadow_execution_id")
  /// `shadow:{instanceId}:{stepId}:{notificationType}`. Live notification code never reads it.
  shadowIdentity      String                @map("shadow_identity")
  workflowId          String                @map("workflow_id")
  workflowVersion     Int                   @map("workflow_version")
  workflowInstanceId  String?               @map("workflow_instance_id")
  executionMode       WorkflowExecutionMode @default(SHADOW) @map("execution_mode")
  /// Defaults to OBSERVATION on purpose: a row whose origin was never stated is kept, not swept.
  source              ShadowEvidenceSource  @default(OBSERVATION)
  triggerEventId      String?               @map("trigger_event_id")
  subjectType         String                @map("subject_type")
  subjectId           String                @map("subject_id")
  recipientType       String?               @map("recipient_type")
  recipientId         String?               @map("recipient_id")
  notificationType    String?               @map("notification_type")
  category            NotificationCategory?
  /// The channel it would have used, once eligibility and preference had been applied.
  intendedChannel     NotificationChannel?  @map("intended_channel")
  /// The declared fallback order it would have walked, as channel names.
  intendedFallback    String[]              @map("intended_fallback")
  /// PASSED / FAILED / the 6B reason. Null when the step had no condition to re-check.
  conditionResult     String?               @map("condition_result")
  /// The 6C reason code, unchanged from what live governance would have produced.
  governanceResult    String?               @map("governance_result")
  outcome             String
  reasonCode          String                @map("reason_code")
  reasonText          String?               @map("reason_text")
  wouldHaveSent       Boolean               @default(false) @map("would_have_sent")
  wouldHaveDeferred   Boolean               @default(false) @map("would_have_deferred")
  wouldHaveSuppressed Boolean               @default(false) @map("would_have_suppressed")
  wouldHaveBlocked    Boolean               @default(false) @map("would_have_blocked")
  deferredUntil       DateTime?             @map("deferred_until")
  traceId             String?               @map("trace_id")
  correlationId       String?               @map("correlation_id")
  createdAt           DateTime              @default(now()) @map("created_at")

  @@index([workflowId, createdAt])
  @@index([workflowInstanceId])
  @@index([outcome, createdAt])
  // Evidence is read by source before anything else: a certification may only cite OBSERVATION rows,
  // and TEST rows are swept separately. Without this, that split scans the whole workflow partition.
  @@index([source, workflowId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@map("automation_shadow_executions")
}

/// Phase 6C-E — why a notification was allowed, held or refused.
///
/// Deliberately separate from `NotificationDelivery`, which answers what became of a delivery. The
/// two questions have different lifetimes: a quiet-hours deferral releases its delivery row
/// entirely, so the only record that a decision was ever taken would otherwise be a log line.
enum NotificationDecision {
  ALLOWED
  SUPPRESSED_RECIPIENT_DAILY_CAP
  SUPPRESSED_WORKFLOW_COOLDOWN
  DEFERRED_QUIET_HOURS
  PREFERENCE_SUPPRESSED
  BLOCKED_POLICY
  GOVERNANCE_UNAVAILABLE
}

/// One row per governance evaluation. A decision log, never a message archive.
model NotificationDecisionAudit {
  id                 String               @id @default(cuid())
  decisionId         String               @unique @map("decision_id")
  /// Null for a deferral: the claim is released, so no delivery row survives to point at.
  notificationId     String?              @map("notification_id")
  /// The stable thread across attempts. A deferral and its resume share this and nothing else.
  idempotencyKey     String               @map("idempotency_key")
  workflowId         String?              @map("workflow_id")
  workflowVersion    Int?                 @map("workflow_version")
  workflowInstanceId String?              @map("workflow_instance_id")
  recipientType      String               @map("recipient_type")
  recipientId        String               @map("recipient_id")
  notificationType   String               @map("notification_type")
  category           NotificationCategory
  /// Null when the decision was taken before a channel had been chosen.
  channelIntent      NotificationChannel? @map("channel_intent")
  decision           NotificationDecision
  reasonCode         String               @map("reason_code")
  /// Short, non-identifying context. Never a message, never a contact detail.
  reasonText         String?              @map("reason_text")
  deferredUntil      DateTime?            @map("deferred_until")
  traceId            String?              @map("trace_id")
  correlationId      String?              @map("correlation_id")
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([recipientType, recipientId, createdAt])
  @@index([workflowId, createdAt])
  @@index([decision, createdAt])
  @@index([notificationId])
  @@index([workflowInstanceId])
  @@map("notification_decision_audits")
}

/// Phase 6C — how many automation notifications a recipient has already had today.
///
/// One row per recipient per calendar day *in that recipient's own timezone*. `used` is only ever
/// moved by a single conditional statement that refuses to go past `cap`, which is what makes the
/// daily limit hold when several workers act on the same person at the same moment.
model NotificationCadenceWindow {
  id            String   @id @default(cuid())
  recipientType String   @map("recipient_type")
  recipientId   String   @map("recipient_id")
  /// The recipient's local calendar day as plain `YYYY-MM-DD` text.
  ///
  /// Deliberately not a date/timestamp column: the day has already been decided in the recipient's
  /// timezone, and storing it as text means no driver or session timezone can shift it afterwards.
  windowDate    String   @map("window_date")
  /// The IANA zone the day was computed in, so an audit can reproduce the boundary.
  timezone      String
  used          Int      @default(0)
  /// The cap in force for this window. Refreshed on each reservation so a policy change applies at once.
  cap           Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([recipientType, recipientId, windowDate], map: "notification_cadence_windows_recipient_day_key")
  @@index([windowDate])
  @@map("notification_cadence_windows")
}

/// Phase 6C — the individual slots that make up a window, one row per logical notification.
///
/// The window row carries the count; these rows carry the identity. Keeping both means a
/// reservation can be idempotent (an idempotency key reserves once, however many times it is
/// replayed) and that "five were sent" is provable from durable rows rather than from a number.
///
/// This is also the source of truth for workflow cooldown, which `NotificationDelivery` cannot
/// answer because it does not record which workflow asked.
model NotificationCadenceReservation {
  id               String               @id @default(cuid())
  /// The 6E' notification operation identity. A replay of the same key never takes a second slot.
  idempotencyKey   String               @unique @map("idempotency_key")
  recipientType    String               @map("recipient_type")
  recipientId      String               @map("recipient_id")
  windowDate       String               @map("window_date")
  /// Which slot of the window this took: 1-based, and never greater than the cap in force.
  slotNo           Int                  @map("slot_no")
  /// Present for workflow-driven notifications; absent for anything reserved outside a workflow.
  workflowId       String?              @map("workflow_id")
  workflowVersion  Int?                 @map("workflow_version")
  notificationType String               @map("notification_type")
  category         NotificationCategory
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([recipientType, recipientId, windowDate])
  @@index([workflowId, recipientType, recipientId, createdAt])
  @@map("notification_cadence_reservations")
}

// ═══════════════════════════ Phase 12 — ML model governance ═══════════════════════════

/// Phase 12 — the lifecycle stage of one model version.
///
/// Ordering is a governance statement, not a convenience: a version reaches PRODUCTION only by
/// passing through CANDIDATE, SHADOW and APPROVED. Nothing in this platform may write PRODUCTION
/// directly, and `promote()` refuses a version that was not APPROVED by a person first.
enum MlModelStage {
  TRAINING
  TRAINED
  EVALUATED
  CANDIDATE
  SHADOW
  APPROVED
  PRODUCTION
  ROLLED_BACK
  REJECTED
  RETIRED
}

/// Phase 12 — one governed version of one model.
///
/// ── Why this lives in Postgres and not in the warehouse ──────────────────────────
///
/// A BigQuery `model_registry` table already exists and is the record of what the warehouse
/// trained. It cannot be the governance record, for three measured reasons: the project's billing
/// is disabled so the table is physically unwritable; BigQuery has no unique constraints, so
/// "exactly one PRODUCTION version per model" cannot be enforced there; and approval has to be
/// attributable and auditable through the same `AuditLogService` and RBAC every other governance
/// act on this platform uses. So the warehouse keeps the training record and this table keeps the
/// lifecycle. They are reconciled, never duplicated — `mlRegistryService.reconcile()` reports any
/// model the warehouse knows about that has no governed version here.
///
/// ── Reproducibility is a column, not a convention ────────────────────────────────
///
/// `datasetVersion`, `featureVersion`, `codeVersion`, `hyperparameters` and `seed` exist so a
/// version can be rebuilt. A registry row that says only "trained on the database" describes
/// nothing: the database has changed since.
model MlModelVersion {
  id        String       @id @default(cuid())
  /// Canonical model name, matching the warehouse registry where one exists.
  modelName String       @map("model_name")
  /// Monotonic per model. Assigned by the service, never by the caller.
  version   Int
  stage     MlModelStage @default(CANDIDATE)

  /// Content hash of the exact training data. Two versions with the same hash saw the same rows.
  datasetVersion String  @map("dataset_version")
  /// Which feature definition produced the inputs. A feature change invalidates comparability.
  featureVersion String  @map("feature_version")
  /// Git-describable identifier of the training code.
  codeVersion    String  @map("code_version")
  /// Where the artifact lives (a BigQuery model reference, or a deterministic rule identifier).
  artifactRef    String  @map("artifact_ref")
  /// Hash of the artifact where one can be computed. Null for warehouse-hosted models whose bytes
  /// this platform never sees — recorded as null rather than as a fabricated digest.
  artifactHash   String? @map("artifact_hash")

  /// Measured out-of-sample metrics. Never in-sample fit statistics presented as accuracy.
  metrics         Json?
  hyperparameters Json?
  /// Present only where the training procedure is actually seeded; null is honest for the rest.
  seed            Int?

  /// What this version was measured against, and whether it won. Null before evaluation.
  baselineName  String?  @map("baseline_name")
  beatsBaseline Boolean? @map("beats_baseline")

  trainedAt   DateTime? @map("trained_at")
  evaluatedAt DateTime? @map("evaluated_at")

  /// Approval is a person. Never a test result, and never a metric threshold.
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  approvalNote String?   @map("approval_note")

  promotedAt          DateTime? @map("promoted_at")
  /// The version this one replaced in production — the rollback target, recorded at promotion time
  /// rather than inferred later from timestamps.
  supersededVersionId String?   @map("superseded_version_id")

  rolledBackAt     DateTime? @map("rolled_back_at")
  rolledBackBy     String?   @map("rolled_back_by")
  rolledBackReason String?   @map("rolled_back_reason")

  rejectedReason String?   @map("rejected_reason")
  retiredAt      DateTime? @map("retired_at")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shadowPredictions MlShadowPrediction[]

  @@unique([modelName, version])
  @@index([modelName, stage])
  @@index([stage, createdAt])
  @@map("ml_model_versions")
}

/// Phase 12 — one shadow observation: what the candidate said, what production said, what happened.
///
/// Shadow mode exists to answer a question no offline metric can: does the candidate behave better
/// on data nobody has seen, while controlling nothing. So a row is written at prediction time with
/// both predictions and no outcome, and the outcome is filled in later when it becomes knowable.
///
/// A shadow prediction never mutates business state. That is enforced by construction — this table
/// is the only thing the shadow path writes.
model MlShadowPrediction {
  id                 String         @id @default(cuid())
  modelName          String         @map("model_name")
  candidateVersionId String         @map("candidate_version_id")
  candidateVersion   MlModelVersion @relation(fields: [candidateVersionId], references: [id], onDelete: Cascade)
  /// The production version in force when this was recorded, or null when nothing was in production.
  productionVersion  Int?           @map("production_version")

  /// What is being predicted about — for demand, the forecast date. Unique per candidate version so
  /// a replayed shadow run updates rather than duplicating.
  entityKey    String   @map("entity_key")
  predictedFor DateTime @map("predicted_for")
  predictedAt  DateTime @default(now()) @map("predicted_at")

  candidateValue  Float  @map("candidate_value")
  /// Null when production produced nothing — an outage is recorded, never filled with a guess.
  productionValue Float? @map("production_value")

  /// The authoritative outcome, written only once it is genuinely observable.
  actualValue Float?    @map("actual_value")
  actualAt    DateTime? @map("actual_at")

  @@unique([candidateVersionId, entityKey])
  @@index([modelName, predictedFor])
  @@map("ml_shadow_predictions")
}

// ═══════════════════════ Phase 14 — AI spend governance ═══════════════════════
//
// Before this, nothing in the platform could stop AI spend. Cost was measured accurately
// (Phase 13) and displayed on a dashboard, but a dashboard is not a control: a runaway loop
// would have been observed, in detail, all the way to the bill.
//
// Two tables rather than one, for the same reason cadence windows are split from reservations:
// the POLICY is the human decision about what the cap is, and the WINDOW is the accumulator the
// enforcement path mutates under concurrency. Mixing them would put a hot per-request UPDATE on
// the row a person edits.

/// What a cap applies to. GLOBAL is the whole platform; the rest narrow by one dimension that
/// already exists on every gateway request, so no new dimension had to be invented to cap on.
enum AiBudgetScope {
  GLOBAL
  PROVIDER
  ROLE
  ENDPOINT

  @@map("ai_budget_scope")
}

enum AiBudgetPeriod {
  DAY
  MONTH

  @@map("ai_budget_period")
}

/// What to do when the cap cannot be evaluated — NOT what to do when it is exceeded.
///
/// These are genuinely different questions and conflating them is how budget controls end up
/// either useless or catastrophic. A cap that is *exceeded* always blocks; that is the point.
/// A cap that cannot be *read* (the database is unreachable mid-incident) is a judgement call:
/// failing closed on a blip takes every AI surface down, failing open during a runaway loop is
/// exactly when the cap was needed. So it is recorded per policy and never assumed.
enum AiBudgetFailMode {
  FAIL_OPEN
  FAIL_CLOSED

  @@map("ai_budget_fail_mode")
}

/// A spend ceiling. Rows are created by a person; this table ships EMPTY on purpose.
///
/// No default cap is seeded because there is no cap this project has agreed to. Inventing one
/// would either be so high it controls nothing or so low it silently breaks AI in production —
/// both are worse than the honest state, which is that the mechanism exists and the number is a
/// human decision.
model AiBudgetPolicy {
  id        String           @id @default(cuid())
  scope     AiBudgetScope
  /// "*" for GLOBAL; otherwise the provider, role or endpoint this cap applies to.
  scopeKey  String           @map("scope_key")
  period    AiBudgetPeriod
  /// The ceiling in USD. Compared against reserved + settled spend, never against settled alone.
  limitUsd  Float            @map("limit_usd")
  failMode  AiBudgetFailMode @default(FAIL_CLOSED) @map("fail_mode")
  isActive  Boolean          @default(true) @map("is_active")
  /// Why this number. Free text, because the justification is the part an auditor needs.
  note      String?
  createdBy String           @map("created_by")
  updatedBy String?          @map("updated_by")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  windows AiBudgetWindow[]

  @@unique([scope, scopeKey, period])
  @@index([isActive])
  @@map("ai_budget_policies")
}

/// One policy's accumulator for one period. The row the enforcement path actually contends on.
///
/// `reservedUsd` exists because AI cost is only knowable AFTER the provider answers. Checking
/// settled spend alone means N concurrent requests all read the same under-limit total and all
/// proceed — the cap is then a suggestion. So the pre-flight step reserves an upper bound and the
/// post-flight step settles it to the real figure, which bounds the overshoot to one in-flight
/// batch instead of leaving it unbounded.
model AiBudgetWindow {
  id        String         @id @default(cuid())
  policyId  String         @map("policy_id")
  policy    AiBudgetPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" for DAY, "YYYY-MM" for MONTH. Plain text for the same reason cadence windows
  /// are: the boundary has already been decided and no session timezone may shift it afterwards.
  windowKey String         @map("window_key")

  /// Upper-bound spend of requests currently in flight. Released on settle.
  reservedUsd         Float @default(0) @map("reserved_usd")
  /// Actual measured spend of completed requests.
  settledUsd          Float @default(0) @map("settled_usd")
  requestCount        Int   @default(0) @map("request_count")
  /// Requests whose provider has no pricing entry. Their real cost is UNKNOWN, so it is counted
  /// here and NOT folded into settledUsd — a request of unknown cost must never read as free.
  /// A non-zero value here means the settled figure understates true spend by this many requests.
  unknownCostRequests Int   @default(0) @map("unknown_cost_requests")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([policyId, windowKey])
  @@index([windowKey])
  @@map("ai_budget_windows")
}

// ═══════════════════════ Phase 15 — AI-assisted workflow drafting ═══════════════════════
//
// ── Why drafts live in their own table ───────────────────────────────────────────
//
// Workflows in this platform are DEFINED IN CODE. `workflow_definitions` holds a frozen snapshot
// of an activated code definition, and the boot-time fingerprint check treats any divergence as
// someone having edited an activated version — it refuses to boot. Writing an AI-generated row
// into that table would therefore either be ignored by the engine or break startup, and would in
// both cases blur the one line that matters: a definition the platform executes exists because a
// person committed it.
//
// So a draft is a proposal, not a workflow. It carries the generated definition, the prompt that
// produced it, the validation verdict and the approval decision — and it never becomes executable
// on its own. Turning an approved draft into a running workflow still requires a developer to
// commit the code definition and a deployment to activate it. That is not a limitation to work
// around; it is the property that stops a language model from authoring production automation.

enum AiWorkflowDraftStatus {
  /// Generated and validated. Nothing has approved it.
  DRAFT
  /// A person reviewed it and said no. Retained — a rejected proposal is evidence.
  REJECTED
  /// A person approved the proposal. Still not executable; it needs a code definition.
  APPROVED
  /// A developer committed the corresponding code definition and it activated.
  IMPLEMENTED

  @@map("ai_workflow_draft_status")
}

/// How much damage the proposal could do if it were ever activated as written.
enum AiWorkflowRiskClass {
  /// Reads and waits only. No message leaves the platform.
  INERT
  /// Sends notifications to real people.
  NOTIFYING
  /// Contains a step type the engine cannot execute, or an escalation to a human queue.
  ESCALATING
  /// Refused by validation — never approvable in this form.
  REJECTED_UNSAFE

  @@map("ai_workflow_risk_class")
}

model AiWorkflowDraft {
  id         String                @id @default(cuid())
  /// Proposed workflow identity. Deliberately NOT unique against `workflow_definitions` — a draft
  /// naming an existing workflow is a proposed change, and refusing to record it would hide that
  /// somebody asked for one.
  proposedId String                @map("proposed_id")
  name       String
  /// The natural-language request. Retained so a reviewer can see what was actually asked for,
  /// and so a suspicious draft can be traced back to the prompt that produced it.
  intent     String
  /// Validated step array. Stored as given, so approval applies to exact bytes.
  steps      Json
  trigger    String
  status     AiWorkflowDraftStatus @default(DRAFT)
  riskClass  AiWorkflowRiskClass   @map("risk_class")

  /// Every validation finding, including the ones that passed. A draft that was approved needs to
  /// show what was checked, not merely that nothing failed.
  validation    Json
  /// Which model and prompt version produced it, so a bad pattern can be traced to its source.
  modelProvider String? @map("model_provider")
  modelName     String? @map("model_name")
  promptVersion Int?    @map("prompt_version")
  /// Hash of the generating prompt. The prompt text itself is in `intent`; this ties the draft to
  /// the exact request without depending on that field staying unedited.
  promptHash    String  @map("prompt_hash")

  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  /// Why it was approved or rejected. Required by the service — an unexplained approval of
  /// machine-generated automation is not a review.
  reviewNote String?   @map("review_note")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([proposedId])
  @@map("ai_workflow_drafts")
}

// ── Phase 16: Governed Agentic Automation ───────────────────────────────────
//
// An agent run is a bounded, persisted, auditable unit of work. Nothing here is executable:
// a row records what an agent proposed, what the policy layer decided, which allowlisted tool
// executed, and whether the expected effect was afterwards observed. Execution itself remains
// in the Phase-5 tool layer (`ai_tool_executions`) and the Phase-6 workflow engine — this
// layer adds identity, planning, bounds and verification on top of them, and never around them.
//
// The join to execution is `AgentRunStep.executionId` → `ai_tool_executions.execution_id`, so
// "which agent caused this side effect" and "what did this agent actually do" are both
// answerable from either end. Not a declared relation, because a step can legitimately have no
// execution (denied, shadowed, awaiting approval) and a foreign key would force one.

enum AgentRunMode {
  /// The agent plans and classifies but performs no side effect. Every step is recorded as it
  /// WOULD have run. Used for evaluation before an agent is trusted with execution.
  SHADOW
  LIVE
}

enum AgentRunStatus {
  CREATED
  PLANNING
  WAITING_POLICY
  WAITING_APPROVAL
  EXECUTING
  VERIFYING
  COMPLETED
  FAILED
  /// Handed to a human. Not a failure — the designed outcome for high-risk work.
  ESCALATED
  CANCELLED
  TIMED_OUT
  ROLLED_BACK
}

enum AgentRiskTier {
  LOW
  MEDIUM
  HIGH
}

enum AgentStepStatus {
  PLANNED
  POLICY_DENIED
  AWAITING_APPROVAL
  EXECUTED
  VERIFIED
  /// The tool reported success but the expected state change was not observed afterwards.
  /// Never silently retried — this is a stop.
  VERIFICATION_FAILED
  FAILED
  SKIPPED
  /// Recorded in shadow mode: fully planned and authorised, deliberately not executed.
  SHADOWED
  /// The side effect may or may not have landed. Inherited from the tool layer; reconcile
  /// downstream rather than retrying.
  INDETERMINATE
}

model AgentRun {
  id             String  @id @default(cuid())
  runId          String  @unique @map("run_id")
  agentId        String  @map("agent_id")
  /// Frozen at run creation. A live definition change must never reinterpret a running agent.
  agentVersion   String  @map("agent_version")
  promptVersion  String? @map("prompt_version")
  policyVersion  String? @map("policy_version")
  toolsetVersion String? @map("toolset_version")
  modelProvider  String? @map("model_provider")
  modelName      String? @map("model_name")

  mode     AgentRunMode
  status   AgentRunStatus @default(CREATED)
  riskTier AgentRiskTier? @map("risk_tier")

  actorId   String?       @map("actor_id")
  actorRole AiGatewayRole @map("actor_role")

  /// MANUAL | EVENT | SCHEDULE. How this run came to exist.
  triggerType String  @map("trigger_type")
  /// The event id, job id or request id behind the trigger.
  triggerRef  String? @map("trigger_ref")
  subjectType String? @map("subject_type")
  subjectId   String? @map("subject_id")

  traceId     String  @map("trace_id")
  /// The event or run that caused this one. With `parentRunId` and `depth`, this is what makes
  /// an agent → workflow → event → same agent cycle detectable rather than merely unlikely.
  causationId String? @map("causation_id")
  parentRunId String? @map("parent_run_id")
  depth       Int     @default(0)

  goal     String
  /// Hash of the validated plan. Binds the executed steps to the plan that was authorised.
  planHash String? @map("plan_hash")
  /// Redacted structured plan. Human-readable rationale and evidence only — never raw model
  /// reasoning, and never used for authorisation.
  plan     Json?

  stepCount        Int   @default(0) @map("step_count")
  toolCallCount    Int   @default(0) @map("tool_call_count")
  promptTokens     Int   @default(0) @map("prompt_tokens")
  completionTokens Int   @default(0) @map("completion_tokens")
  costUsd          Float @default(0) @map("cost_usd")
  latencyMs        Int?  @map("latency_ms")

  /// Why the run ended where it did: BUDGET_EXHAUSTED, MAX_STEPS, RECURSION_BLOCKED, …
  stopReason       String? @map("stop_reason")
  escalationReason String? @map("escalation_reason")
  errorCode        String? @map("error_code")
  errorMessage     String? @map("error_message")

  /// One run per (agent, trigger, subject). What makes a replayed or duplicated event
  /// produce one run rather than several.
  idempotencyKey String? @unique @map("idempotency_key")

  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Lease held by the process advancing this run. Lets a run orphaned by a crash be
  /// recovered from its persisted state instead of restarted from step zero.
  heartbeatAt DateTime? @map("heartbeat_at")
  completedAt DateTime? @map("completed_at")

  steps AgentRunStep[]

  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@index([traceId])
  @@index([causationId])
  @@index([subjectType, subjectId])
  @@map("agent_runs")
}

model AgentRunStep {
  id               String                @id @default(cuid())
  runId            String                @map("run_id")
  stepIndex        Int                   @map("step_index")
  /// The lifecycle phase this row records: PLAN, POLICY, EXECUTE, VERIFY, ESCALATE.
  phase            String
  /// Agent-facing capability name. Resolves to `toolId` through the agent's capability map;
  /// a model never names a tool directly.
  capability       String?
  toolId           String?               @map("tool_id")
  argumentsHash    String?               @map("arguments_hash")
  /// Redacted arguments, for the operator timeline. Never consulted for authorisation.
  argumentsPreview Json?                 @map("arguments_preview")
  riskTier         AgentRiskTier?        @map("risk_tier")
  policyDecision   AiToolPolicyDecision? @map("policy_decision")
  status           AgentStepStatus
  /// Joins to `ai_tool_executions.execution_id`. Absent when nothing executed.
  executionId      String?               @map("execution_id")
  approvalId       String?               @map("approval_id")
  /// What was checked after execution and what was found. Absent means no post-condition was
  /// declared — which the runtime refuses for write steps.
  verification     Json?
  errorCode        String?               @map("error_code")
  errorMessage     String?               @map("error_message")
  durationMs       Int?                  @map("duration_ms")
  createdAt        DateTime              @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, stepIndex])
  @@index([toolId, createdAt])
  @@index([executionId])
  @@map("agent_run_steps")
}

/// Atomic daily counters behind human-readable document numbers (src/lib/booking-number.ts).
/// Written with raw SQL only; CHECK (value > 0) lives in migration 20260919100000_document_sequences.
model DocumentSequence {
  scope     String
  day       DateTime @db.Date
  value     Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([scope, day])
  @@map("document_sequences")
}

/// Shared acknowledgement of live ops alerts (admin /alerts). Raw SQL only (services/ops-alert-ack.service.ts);
/// CHECKs live in migration 20260919110000_ops_alert_acknowledgements.
model OpsAlertAcknowledgement {
  alertKey       String   @id @map("alert_key")
  acknowledgedBy String   @map("acknowledged_by")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("ops_alert_acknowledgements")
}

/// Append-only booking history, written ONLY by trigger bookings_status_history_trg
/// (migration 20260919120000_booking_status_history). Actor/reason/request id: src/lib/booking-audit-context.ts.
model BookingStatusHistory {
  id               BigInt    @id @default(autoincrement())
  bookingId        String    @map("booking_id")
  oldStatus        String?   @map("old_status")
  newStatus        String    @map("new_status")
  oldProviderId    String?   @map("old_provider_id")
  newProviderId    String?   @map("new_provider_id")
  oldPaymentStatus String?   @map("old_payment_status")
  newPaymentStatus String?   @map("new_payment_status")
  oldScheduledDate DateTime? @map("old_scheduled_date")
  newScheduledDate DateTime? @map("new_scheduled_date")
  actorType        String?   @map("actor_type")
  actorId          String?   @map("actor_id")
  reason           String?
  requestId        String?   @map("request_id")
  changedAt        DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([bookingId, changedAt], map: "booking_status_history_booking_idx")
  @@index([changedAt], map: "booking_status_history_changed_at_idx")
  @@map("booking_status_history")
}

/// Provenance of a business-shaped row.
///
/// NULL means UNKNOWN. `INFERRED_*` is derived after the fact from historical markers by an
/// explicit, reproducible rule — it is deliberately NOT the same value as a label a script declared
/// about a row it was creating, so guesswork cannot harden into fact.
///
/// Business analytics default to `data_origin IS NULL OR data_origin = 'REAL'`; see
/// `src/lib/analytics-scope.ts`, which is the single place that policy is expressed.
enum DataOrigin {
  REAL
  FIXTURE
  TEST
  CERTIFICATION
  SYNTHETIC
  INFERRED_FIXTURE
  INFERRED_TEST
  INFERRED_CERTIFICATION
  INFERRED_SYNTHETIC
}

/// Phase 09 — one booking per (user, Idempotency-Key). A retry of the SAME request replays the same
/// booking; the same key with a different request is refused rather than quietly creating a second
/// one. Rows expire, so the table stays bounded. Requests that send no key are unaffected.
model BookingIdempotencyKey {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  key         String
  /// Fingerprint of the request this key was first used for.
  requestHash String    @map("request_hash")
  bookingId   String?   @map("booking_id")
  /// IN_PROGRESS | COMPLETED
  status      String    @default("IN_PROGRESS")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime  @map("expires_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("booking_idempotency_keys")
}
