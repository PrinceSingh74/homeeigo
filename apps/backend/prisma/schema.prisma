  @@map("encryption_keys")
}

model EnterpriseAuditLog {
  id                 String                @id @default(cuid())
  action             String
  resource           String
  resourceId         String?               @map("resource_id")
  actor              String?
  actorType          EnterpriseActorType   @map("actor_type")
  changesBefore      Json?                 @map("changes_before")
  changesAfter       Json?                 @map("changes_after")
  changesSummary     String?               @map("changes_summary")
  ipAddress          String?               @map("ip_address")
  userAgent          String?               @map("user_agent")
  deviceId           String?               @map("device_id")
  /// A correlation id, NOT an identity.
  ///
  /// This was `@unique`, which silently made the audit log hold at most ONE event per request.
  /// A single admin action routinely produces several — an approval and the promotion it enables,
  /// a denial and the access attempt behind it — and every event after the first failed its insert
  /// and was swallowed by the audit service's catch. The trail was therefore thinnest on exactly
  /// the complex requests an investigation cares about; a promotion audited under the same trace
  /// as its approval simply did not exist. Indexed, because traces are filtered on; not unique,
  /// because many events share one by design.
  traceId            String                @map("trace_id")
  status             EnterpriseAuditStatus @default(SUCCESS)
  errorMessage       String?               @map("error_message")
  retentionCategory  RetentionCategory     @map("retention_category")
  retentionExpiresAt DateTime?             @map("retention_expires_at")
  isArchived         Boolean               @default(false) @map("is_archived")
  archivedAt         DateTime?             @map("archived_at")
  hash               String?
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([actor])
  /// Serves getAuditLogs()'s `WHERE action = ? [AND created_at range] ORDER BY created_at DESC
  /// LIMIT n`. Measured on 273k real rows: 4,279 -> 57 shared buffers, 5,047 -> 0 rows discarded
  /// by filter, 1.36ms -> 0.24ms. Replaces the standalone @@index([action]) — a leading-column
  /// prefix serves action-only lookups equally well (verified: Index Only Scan, 0.375ms), and
  /// that index had recorded zero scans.
  @@index([action, createdAt])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@index([traceId])
  @@index([retentionExpiresAt])
  @@index([isArchived])
  @@map("enterprise_audit_logs")
}

