model RefundRequest {
  /// Provenance. NULL = UNKNOWN. Nullable with no default on purpose: defaulting to REAL would
  /// silently relabel every historical row as genuine business data.
  dataOrigin       DataOrigin?         @map("data_origin")
  id               String              @id @default(cuid())
  paymentId        String              @map("payment_id")
  userId           String              @map("user_id")
  amount           Float
  amountPaise      BigInt              @default(0) @map("amount_paise")
  reason           String
  reasonCode       String?             @map("reason_code")
  status           RefundRequestStatus @default(REQUESTED)
  requestedBy      String              @map("requested_by")
  reviewedBy       String?             @map("reviewed_by")
  reviewNotes      String?             @map("review_notes")
  razorpayRefundId String?             @map("razorpay_refund_id")
  processedAt      DateTime?           @map("processed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  idempotencyKey   String              @unique @map("idempotency_key")
  gatewayRefundId  String?             @unique @map("gateway_refund_id")
  /// Attempts already spent. Persisted rather than counted from RETRY audits, so an exhausted
  /// refund can be excluded by the scan's WHERE clause instead of occupying a slot in its window.
  retryCount       Int                 @default(0) @map("retry_count")
  /// Earliest instant this refund may be retried. NULL means "immediately eligible".
  nextRetryAt      DateTime?           @map("next_retry_at")
  audits           RefundAudit[]

  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@index([status, nextRetryAt])
  @@map("refund_requests")
}

