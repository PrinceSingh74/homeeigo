generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  /// Provenance. NULL = UNKNOWN. Nullable with no default on purpose: defaulting to REAL would
  /// silently relabel every historical row as genuine business data.
  dataOrigin                  DataOrigin?                  @map("data_origin")
  id                          String                       @id @default(cuid())
  email                       String?
  phoneNumber                 String?                      @map("phone_number")
  emailEncrypted              String?                      @map("email_encrypted")
  emailHash                   String?                      @unique @map("email_hash")
  emailEncryptionKeyVersion   Int?                         @map("email_encryption_key_version")
  phoneEncrypted              String?                      @map("phone_encrypted")
  phoneHash                   String?                      @unique @map("phone_hash")
  phoneEncryptionKeyVersion   Int?                         @map("phone_encryption_key_version")
  dataEncryptionStatus        DataEncryptionStatus         @default(PARTIAL) @map("data_encryption_status")
  dataEncryptedAt             DateTime?                    @map("data_encrypted_at")
  firstName                   String                       @map("first_name")
  lastName                    String                       @map("last_name")
  profileImage                String?                      @map("profile_image")
  bio                         String?
  dateOfBirth                 DateTime?                    @map("date_of_birth")
  gender                      String?
  role                        UserRole                     @default(CUSTOMER)
  password                    String
  passwordChangedAt           DateTime?                    @map("password_changed_at")
  passwordResetToken          String?                      @unique @map("password_reset_token")
  passwordResetExpires        DateTime?                    @map("password_reset_expires")
  isEmailVerified             Boolean                      @default(false) @map("is_email_verified")
  emailVerifiedAt             DateTime?                    @map("email_verified_at")
  isPhoneVerified             Boolean                      @default(false) @map("is_phone_verified")
  phoneVerifiedAt             DateTime?                    @map("phone_verified_at")
  isActive                    Boolean                      @default(true) @map("is_active")
  isBanned                    Boolean                      @default(false) @map("is_banned")
  bannedReason                String?                      @map("banned_reason")
  bannedAt                    DateTime?                    @map("banned_at")
  kycStatus                   KycStatus                    @default(NOT_STARTED) @map("kyc_status")
  kycDocumentUrl              String?                      @map("kyc_document_url")
  kycDocumentType             String?                      @map("kyc_document_type")
  kycDocumentNumber           String?                      @map("kyc_document_number")
  kycVerifiedAt               DateTime?                    @map("kyc_verified_at")
  kycRejectionReason          String?                      @map("kyc_rejection_reason")
  defaultAddressId            String?                      @map("default_address_id")
  preferredCity               String?                      @map("preferred_city")
  defaultLanguage             String                       @default("en") @map("default_language")
  timezone                    String                       @default("Asia/Kolkata")
  darkMode                    Boolean                      @default(false) @map("dark_mode")
  notificationsEnabled        Boolean                      @default(true) @map("notifications_enabled")
  emailNotifications          Boolean                      @default(true) @map("email_notifications")
  pushNotifications           Boolean                      @default(true) @map("push_notifications")
  smsNotifications            Boolean                      @default(true) @map("sms_notifications")
  walletBalance               Float                        @default(0) @map("wallet_balance")
  walletBalancePaise          BigInt                       @default(0) @map("wallet_balance_paise")
  walletCurrency              String                       @default("INR") @map("wallet_currency")
  totalSpent                  Float                        @default(0) @map("total_spent")
  totalSpentPaise             BigInt                       @default(0) @map("total_spent_paise")
  totalSaved                  Float                        @default(0) @map("total_saved")
  totalSavedPaise             BigInt                       @default(0) @map("total_saved_paise")
  referralCode                String?                      @unique @map("referral_code")
  referredBy                  String?                      @map("referred_by")
  referralCount               Int                          @default(0) @map("referral_count")
  referralBonusUsed           Boolean                      @default(false) @map("referral_bonus_used")
  lastLoginAt                 DateTime?                    @map("last_login_at")
  lastActivityAt              DateTime?                    @map("last_activity_at")
  loginCount                  Int                          @default(0) @map("login_count")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  kycDocumentNumberHash       String?                      @unique @map("kyc_document_number_hash")
  emailVerificationExpires    DateTime?                    @map("email_verification_expires")
  emailVerificationToken      String?                      @unique @map("email_verification_token")
  deletionScheduledAt         DateTime?                    @map("deletion_scheduled_at")
  activityLogs                ActivityLog[]
  addresses                   Address[]
  adminProfile                AdminUser?
  aiConversations             AiConversation[]
  bookings                    Booking[]
  bookingIdempotencyKeys      BookingIdempotencyKey[]
  consentRecords              ConsentRecord[]
  couponUsages                CouponUsage[]
  fraudAlerts                 FraudAlert[]
  fraudRiskScore              FraudRiskScore?
  fraudSignals                FraudSignal[]
  giftCardTransactions        GiftCardTransaction[]
  giftCardsPurchased          GiftCard[]                   @relation("GiftPurchaser")
  visionImages                VisionImage[]
  giftCardsReceived           GiftCard[]                   @relation("GiftRecipient")
  hcoinTransactions           HCoinTransaction[]
  hcoinWallet                 HCoinWallet?
  benefitUsages               MembershipBenefitUsage[]
  membershipCashbacks         MembershipCashback[]
  membershipCouponRedemptions MembershipCouponRedemption[]
  notifications               Notification[]
  otps                        OTP[]
  partnerRegistrationSession  PartnerRegistrationSession?
  partnerLead                 PartnerLead?
  passwordHistories           PasswordHistory[]
  payments                    Payment[]
  providerMatchScores         ProviderMatchScore[]
  provider                    Provider?
  ratingsGiven                Rating[]
  referralCommissions         ReferralCommission[]         @relation("RefCommissionEarned")
  referralsReceived           ReferralTransaction?         @relation("ReferralReceived")
  referralsMade               ReferralTransaction[]        @relation("ReferralsMade")
  referralWithdrawals         ReferralWithdrawal[]
  refreshTokens               RefreshToken[]
  supportTickets              SupportTicket[]
  tokenBlacklist              TokenBlacklist[]
  authEpoch                   UserAuthEpoch?
  devices                     UserDevice[]
  subscriptions               UserSubscription[]
  walletTransactions          WalletTransaction[]
  transfersReceived           WalletTransfer[]             @relation("TransferRecipient")
  transfersSent               WalletTransfer[]             @relation("TransferSender")
  complianceRequests          ComplianceRequest[]
  complianceRequestAudits     ComplianceRequestAudit[]
  dataExportRequests          DataExportRequest[]
  deletionRequests            DeletionRequest[]
  savedPaymentMethods         SavedPaymentMethod[]
  bookingMessages             BookingMessage[]

  @@index([kycStatus])
  @@index([isActive])
  @@index([isBanned])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model UserDevice {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  deviceId       String       @map("device_id")
  platform       PushPlatform
  deviceName     String?      @map("device_name")
  appVersion     String?      @map("app_version")
  osVersion      String?      @map("os_version")
  expoPushToken  String       @unique @map("expo_push_token")
  tokenUpdatedAt DateTime     @default(now()) @map("token_updated_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  isActive       Boolean      @default(true) @map("is_active")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("user_devices")
}

model OTP {
  id           String    @id @default(cuid())
  userId       String?   @map("user_id")
  phoneNumber  String?   @map("phone_number")
  phoneHash    String?   @map("phone_hash")
  otpHash      String    @map("otp_hash")
  expiresAt    DateTime  @map("expires_at")
  isUsed       Boolean   @default(false) @map("is_used")
  attemptCount Int       @default(0) @map("attempt_count")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, createdAt])
  @@index([phoneHash, createdAt])
  @@index([expiresAt])
  @@index([userId])
  @@map("otps")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_histories")
}

model Provider {
  id                          String                         @id @default(cuid())
  userId                      String                         @unique @map("user_id")
  businessName                String?                        @map("business_name")
  businessLicense             String?                        @unique @map("business_license")
  taxId                       String?                        @map("tax_id")
  serviceCategories           String[]                       @default([]) @map("service_categories")
  serviceRegions              String[]                       @default([]) @map("service_regions")
  bio                         String?
  isVerified                  Boolean                        @default(false) @map("is_verified")
  verificationDate            DateTime?                      @map("verification_date")
  verificationNotes           String?                        @map("verification_notes")
  certifications              String[]                       @default([])
  backgroundCheckStatus       BackgroundCheckStatus          @default(NOT_DONE) @map("background_check_status")
  backgroundCheckDate         DateTime?                      @map("background_check_date")
  profileImage                String?                        @map("profile_image")
  rating                      Float                          @default(0)
  totalReviews                Int                            @default(0) @map("total_reviews")
  ratingBreakdown             String?                        @map("rating_breakdown")
  totalBookings               Int                            @default(0) @map("total_bookings")
  completedBookings           Int                            @default(0) @map("completed_bookings")
  cancelledBookings           Int                            @default(0) @map("cancelled_bookings")
  rejectedBookings            Int                            @default(0) @map("rejected_bookings")
  completionRate              Float                          @default(0) @map("completion_rate")
  responseRate                Float                          @default(0) @map("response_rate")
  cancellationRate            Float                          @default(0) @map("cancellation_rate")
  onTimeRate                  Float                          @default(0) @map("on_time_rate")
  acceptanceRate              Float                          @default(0) @map("acceptance_rate")
  avgResponseTime             Float                          @default(0) @map("avg_response_time")
  avgCompletionTime           Float                          @default(0) @map("avg_completion_time")
  isOnline                    Boolean                        @default(false) @map("is_online")
  onlineSince                 DateTime?                      @map("online_since")
  lastSeenAt                  DateTime?                      @map("last_seen_at")
  currentStatus               String                         @default("offline") @map("current_status")
  workingHoursStart           String?                        @map("working_hours_start")
  workingHoursEnd             String?                        @map("working_hours_end")
  workingDays                 String[]                       @default([]) @map("working_days")
  maxJobsPerDay               Int?                           @map("max_jobs_per_day")
  maxConcurrentJobs           Int                            @default(4) @map("max_concurrent_jobs")
  breakWindows                Json?                          @map("break_windows")
  pausedAt                    DateTime?                      @map("paused_at")
  pauseReason                 String?                        @map("pause_reason")
  timezone                    String                         @default("Asia/Kolkata")
  walletBalance               Float                          @default(0) @map("wallet_balance")
  walletBalancePaise          BigInt                         @default(0) @map("wallet_balance_paise")
  totalEarnings               Float                          @default(0) @map("total_earnings")
  totalEarningsPaise          BigInt                         @default(0) @map("total_earnings_paise")
  thisMonthEarnings           Float                          @default(0) @map("this_month_earnings")
  thisWeekEarnings            Float                          @default(0) @map("this_week_earnings")
  commissionRate              Float                          @default(20) @map("commission_rate")
  bankAccountHolder           String?                        @map("bank_account_holder")
  bankAccountNumber           String?                        @map("bank_account_number")
  bankIfscCode                String?                        @map("bank_ifsc_code")
  bankName                    String?                        @map("bank_name")
  paymentMethodPreference     String                         @default("bank_transfer") @map("payment_method_preference")
  upiId                       String?                        @map("upi_id")
  isActive                    Boolean                        @default(true) @map("is_active")
  isBanned                    Boolean                        @default(false) @map("is_banned")
  bannedReason                String?                        @map("banned_reason")
  bannedAt                    DateTime?                      @map("banned_at")
  isApproved                  Boolean                        @default(false) @map("is_approved")
  approvalNotes               String?                        @map("approval_notes")
  pushTokens                  String[]                       @map("push_tokens")
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  badges                      String[]                       @default([])
  registrationStatus          PartnerRegistrationStatus      @default(PENDING) @map("registration_status")
  registeredAt                DateTime?                      @map("registered_at")
  partnerApprovedAt           DateTime?                      @map("partner_approved_at")
  rejectedAt                  DateTime?                      @map("rejected_at")
  rejectionReason             String?                        @map("rejection_reason")
  changesRequestedAt          DateTime?                      @map("changes_requested_at")
  changesRequestedStep        String?                        @map("changes_requested_step")
  changesRequestedNotes       String?                        @map("changes_requested_notes")
  city                        String?
  experienceYears             Int                            @default(0) @map("experience_years")
  primarySkill                String?                        @map("primary_skill")
  secondarySkills             String[]                       @default([]) @map("secondary_skills")
  emergencyContactName        String?                        @map("emergency_contact_name")
  emergencyContactPhone       String?                        @map("emergency_contact_phone")
  complianceRestricted        Boolean                        @default(false) @map("compliance_restricted")
  complianceRestrictedAt      DateTime?                      @map("compliance_restricted_at")
  complianceRestrictionReason String?                        @map("compliance_restriction_reason")
  /// Section 06 partner program lifecycle — distinct from availability FSM (`currentStatus` / `pausedAt`).
  lifecycleState              PartnerLifecycleState          @default(APPLIED) @map("lifecycle_state")
  /// Section 06 career ladder — distinct from customer membership tiers and commission volume bands.
  careerLevel                 PartnerCareerLevel             @default(STARTER) @map("career_level")
  serviceRadiusKm             Float?                         @map("service_radius_km")
  baseLatitude                Float?                         @map("base_latitude")
  baseLongitude               Float?                         @map("base_longitude")
  panNumber                   String?                        @map("pan_number")
  aadharNumber                String?                        @map("aadhar_number")
  adminApprovedBy             String?                        @map("admin_approved_by")
  /// Lookup hashes for encrypted KYC / payout identity. Each is unique on purpose:
  /// one PAN, Aadhaar, bank account, UPI id or tax id may belong to only one partner.
  /// Duplicate payout-account prevention is a persistence rule, not a post-hoc risk signal.
  /// Section 07 `BANK_REUSE` inspects hashes that survived this constraint (races, imports);
  /// a canonical KYC write is refused by `assertProviderKycUnique` before it can land.
  taxIdHash                   String?                        @unique @map("tax_id_hash")
  bankAccountNumberHash       String?                        @unique @map("bank_account_number_hash")
  upiIdHash                   String?                        @unique @map("upi_id_hash")
  panNumberHash               String?                        @unique @map("pan_number_hash")
  aadharNumberHash            String?                        @unique @map("aadhar_number_hash")
  reservedBalance             Float                          @default(0) @map("reserved_balance")
  reservedBalancePaise        BigInt                         @default(0) @map("reserved_balance_paise")
  activityLogs                ActivityLog[]
  assignmentAttempts          AssignmentAttempt[]
  bookings                    Booking[]
  jobEvidence                 JobEvidence[]
  earnings                    Earning[]
  locationHistory             LocationHistory[]
  currentLocation             Location?
  notifications               Notification[]
  partnerBackgroundCheck      PartnerBackgroundCheck?
  partnerLead                 PartnerLead?
  partnerAssessments          PartnerAssessment[]
  documents                   ProviderDocument[]
  complianceReminders         PartnerComplianceReminder[]
  complianceRestrictions      PartnerComplianceRestriction[]
  riskProfile                 PartnerRiskProfile?
  riskSignals                 PartnerRiskSignal[]
  safetyIncidents             PartnerSafetyIncident[]
  providerMatchScores         ProviderMatchScore[]
  walletReservations          ProviderWalletReservation[]
  attendanceSessions          PartnerAttendanceSession[]
  presence                    PartnerPresence?
  incentivePayouts            PartnerIncentivePayout[]
  academyProgress             PartnerAcademyProgress[]
  unifiedScore                PartnerScore?
  scoreHistory                PartnerScoreHistory[]
  careerHistory               PartnerCareerHistory[]
  lifecycleHistory            PartnerStatusHistory[]
  badgeAwards                 PartnerBadgeAward[]
  referralsMade               PartnerReferral[]              @relation("PartnerReferralsMade")
  referralReceived            PartnerReferral?               @relation("PartnerReferralReceived")
  partnerReferralCode         PartnerReferralCode?
  referralRewardsEarned       PartnerReferralReward[]
  user                        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews                     Rating[]                       @relation("ProviderReviews")
  supportTickets              SupportTicket[]
  walletTransactions          WalletTransaction[]
  withdrawals                 Withdrawal[]

  @@index([isOnline])
  @@index([pausedAt])
  @@index([currentStatus])
  @@index([rating])
  @@index([isVerified])
  @@index([isApproved])
  @@index([registrationStatus])
  @@index([isActive])
  @@index([complianceRestricted])
  @@index([completionRate])
  @@index([createdAt])
  @@index([lifecycleState])
  @@index([careerLevel])
  @@map("providers")
}

model Service {
  id                  String                   @id @default(cuid())
  name                String                   @unique
  slug                String                   @unique
  description         String
  detailedDescription String?                  @map("detailed_description")
  category            String
  subcategory         String?
  basePrice           Float                    @map("base_price")
  minPrice            Float?                   @map("min_price")
  maxPrice            Float?                   @map("max_price")
  currency            String                   @default("INR")
  estimatedDuration   Int                      @map("estimated_duration")
  durationRange       String?                  @map("duration_range")
  isActive            Boolean                  @default(false) @map("is_active")
  isFeatured          Boolean                  @default(false) @map("is_featured")
  isPopular           Boolean                  @default(false) @map("is_popular")
  isPromoted          Boolean                  @default(false) @map("is_promoted")
  popularity          Int                      @default(0)
  bookingCount        Int                      @default(0) @map("booking_count")
  icon                String?
  images              String[]
  thumbnail           String?
  includedServices    String[]                 @map("included_services")
  excludedServices    String[]                 @map("excluded_services")
  requirements        String[]
  availableCities     String[]                 @map("available_cities")
  unavailableCities   String[]                 @map("unavailable_cities")
  tags                String[]
  seoTitle            String?                  @map("seo_title")
  seoDescription      String?                  @map("seo_description")
  seoKeywords         String?                  @map("seo_keywords")
  pricingModel        String                   @default("fixed") @map("pricing_model")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  premiumOnly         Boolean                  @default(false) @map("premium_only")
  /// Admin-managed booking/content configuration (quantity rules, variants, audiences,
  /// policies, content, add-ons). Validated by src/lib/service-catalog-config.ts.
  catalogConfig       Json?                    @map("catalog_config")
  /// Stable business code (defaults to slug on create; never rewritten by a rename). Distinct from
  /// `slug` (public URL) and `internalServiceCode` (operational). Never sent to customers.
  serviceCode         String                   @unique @default(dbgenerated()) @map("service_code")
  /// Optional operational identifier (ops / ERP / ledger). Unique when set. Admin-only.
  internalServiceCode String?                  @unique @map("internal_service_code")
  /// Provenance (same model as bookings/users). NULL = unknown = treated as real. Non-real origins never reach
  /// the customer catalogue, customer quotes or partner onboarding.
  dataOrigin          DataOrigin?              @map("data_origin")
  /// Partner calendar policy (owner decision D1): DURATION reserves [start−30, start+duration+30);
  /// FIXED keeps the 60-minute block (services whose duration is a turnaround time, e.g. laundry).
  partnerSlotPolicy   String                   @default("DURATION") @map("partner_slot_policy")
  displayName         String?                  @map("display_name")
  shortName           String?                  @map("short_name")
  /// Customer taxonomy (service_categories tree). `category` stays the operational string used by
  /// dispatch; the DB trigger services_resolve_taxonomy derives `categoryId` from it when unset.
  categoryId          String?                  @map("category_id")
  subcategoryId       String?                  @map("subcategory_id")
  parentServiceId     String?                  @map("parent_service_id")
  taxonomyCategory    ServiceCategory?         @relation("ServiceTaxonomyCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  taxonomySubcategory ServiceCategory?         @relation("ServiceTaxonomySubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  parentService       Service?                 @relation("ServiceFamily", fields: [parentServiceId], references: [id], onDelete: SetNull)
  childServices       Service[]                @relation("ServiceFamily")
  capabilityProfile   ServiceCapabilityProfile @default(GENERAL) @map("capability_profile")
  lifecycleStatus     ServiceLifecycleStatus   @default(DRAFT) @map("lifecycle_status")
  configStatus        ServiceConfigStatus      @default(READY) @map("config_status")
  isCustomerVisible   Boolean                  @default(false) @map("is_customer_visible")
  isBookable          Boolean                  @default(false) @map("is_bookable")
  version             Int                      @default(1)
  ownerTeam           String?                  @map("owner_team")
  operationsNotes     String?                  @map("operations_notes")
  lastReviewedAt      DateTime?                @map("last_reviewed_at") @db.Timestamptz(6)
  publishedAt         DateTime?                @map("published_at") @db.Timestamptz(6)
  publishedBy         String?                  @map("published_by")
  createdBy           String?                  @map("created_by")
  updatedBy           String?                  @map("updated_by")
  bookings            Booking[]
  intervalPolicies    ServiceIntervalPolicy[]
  configVersions      ServiceConfigVersion[]
  variants            ServiceVariant[]
  addons              ServiceAddon[]
  requirementAssignments ServiceRequirement[]

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([popularity])
  @@index([lifecycleStatus])
  @@index([isBookable])
  @@index([isCustomerVisible])
  @@index([capabilityProfile])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([parentServiceId])
  @@index([dataOrigin])
  @@map("services")
}

/// Immutable published catalogue snapshot. Historical bookings point at a version number,
/// not at the live `catalog_config`, so later admin edits cannot rewrite what was sold.
model ServiceConfigVersion {
  id            String    @id @default(cuid())
  serviceId     String    @map("service_id")
  version       Int
  status        String    @default("PUBLISHED")
  catalogConfig Json      @map("catalog_config")
  snapshot      Json
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, version])
  @@index([serviceId, status])
  @@map("service_config_versions")
}

/// Queryable catalogue options. `code` is the id customers send (`variantId`).
/// Prices here feed `resolveSelection` after hydrate — not a second pricing engine.
model ServiceVariant {
  id               String   @id @default(cuid())
  serviceId        String   @map("service_id")
  code             String
  name             String
  description      String?
  price            Float
  durationMin      Int?     @map("duration_min")
  audiences        String[]
  inclusions       String[]
  exclusions       String[]
  requirements     String[]
  quantityOverride Json?    @map("quantity_override")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, code])
  @@index([serviceId, isActive])
  @@map("service_variants")
}

model ServiceAddon {
  id                      String   @id @default(cuid())
  serviceId               String   @map("service_id")
  code                    String
  name                    String
  description             String?
  price                   Float
  durationMin             Int?     @map("duration_min")
  quantityAllowed         Boolean  @default(true) @map("quantity_allowed")
  /// Most units of this add-on one booking may take. NULL = exactly one.
  maxQuantity             Int?     @map("max_quantity")
  compatibleVariantCodes  String[] @map("compatible_variant_codes")
  requiresAddonCodes      String[] @default([]) @map("requires_addon_codes")
  conflictsWithAddonCodes String[] @default([]) @map("conflicts_with_addon_codes")
  sortOrder               Int      @default(0) @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  service                 Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, code])
  @@index([serviceId, isActive])
  @@map("service_addons")
}

/// Phase 06 reusable catalogue: a material, a piece of equipment, or a customer precondition.
/// Business data — nothing is seeded. Referenced by service_requirements (ON DELETE RESTRICT).
model ServiceRequirementItem {
  id            String               @id
  code          String               @unique(map: "service_requirement_items_code_key")
  kind          String
  name          String
  customerLabel String?              @map("customer_label")
  description   String?
  isActive      Boolean              @default(true) @map("is_active")
  version       Int                  @default(1)
  createdBy     String?              @map("created_by")
  updatedBy     String?              @map("updated_by")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  assignments   ServiceRequirement[]

  @@index([kind, isActive], map: "service_requirement_items_kind_active_idx")
  @@map("service_requirement_items")
}

/// Phase 06 per-service assignment, synced from catalog_config.requirements in the service write
/// transaction (same contract as service_variants / service_addons). responsibility / procurement /
/// charge are three separate facts; CHECK constraints in the migration enforce their consistency.
model ServiceRequirement {
  id                  String                 @id
  serviceId           String                 @map("service_id")
  code                String
  itemId              String                 @map("item_id")
  responsibility      String
  procurement         String?
  charge              String                 @default("NOT_APPLICABLE")
  isOptional          Boolean                @default(false) @map("is_optional")
  enforcement         String                 @default("INFORMATIONAL")
  verification        String                 @default("NONE")
  quantity            Decimal?               @db.Decimal(12, 3)
  unit                String?
  quantityBasis       String?                @map("quantity_basis")
  whenVariantCodes    String[]               @default([]) @map("when_variant_codes")
  whenAddonCodes      String[]               @default([]) @map("when_addon_codes")
  whenMinQuantity     Int?                   @map("when_min_quantity")
  customerNote        String?                @map("customer_note")
  customerWarning     String?                @map("customer_warning")
  partnerInstructions String?                @map("partner_instructions")
  handlingNote        String?                @map("handling_note")
  internalNote        String?                @map("internal_note")
  sortOrder           Int                    @default(0) @map("sort_order")
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  service             Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  item                ServiceRequirementItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([serviceId, code], map: "service_requirements_service_code_key")
  @@index([serviceId, isActive], map: "service_requirements_service_active_idx")
  @@index([itemId], map: "service_requirements_item_idx")
  @@map("service_requirements")
}

/// Customer taxonomy tree: top-level rows are categories, rows with `parentId` are subcategories
/// (exactly two levels — enforced by trigger service_categories_depth_guard). Public URLs use `slug`.
/// `operationalCategories` lists the `services.category` dispatch strings that fall into a category.
model ServiceCategory {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  name                  String
  shortName             String?           @map("short_name")
  description           String?
  sortOrder             Int               @default(0) @map("sort_order")
  isActive              Boolean           @default(true) @map("is_active")
  operationalCategories String[]          @default([]) @map("operational_categories")
  parentId              String?           @map("parent_id")
  parent                ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children              ServiceCategory[] @relation("CategoryTree")
  services              Service[]         @relation("ServiceTaxonomyCategory")
  subcategoryServices   Service[]         @relation("ServiceTaxonomySubcategory")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([parentId, sortOrder])
  @@map("service_categories")
}

