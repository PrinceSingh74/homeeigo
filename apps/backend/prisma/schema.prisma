/// Phase 1 — Partner presence evidence (liveness subsystem; NOT a fifth FSM).
/// One durable snapshot per partner; heartbeats upsert this row (no per-ping history table).
model PartnerPresence {
  id                     String    @id @default(cuid())
  providerId             String    @unique @map("provider_id")
  activeSessionId        String?   @map("active_session_id")
  activeDeviceId         String?   @map("active_device_id")
  lastHeartbeatAt        DateTime? @map("last_heartbeat_at")
  lastSeenAt             DateTime? @map("last_seen_at")
  /// Device capture time of the last accepted fix. Freshness is measured against THIS.
  lastLocationAt         DateTime? @map("last_location_at")
  /// Server receive time of that same fix. `receivedAt - capturedAt` is the transport lag.
  lastLocationReceivedAt DateTime? @map("last_location_received_at")
  lastLocationLat        Float?    @map("last_location_lat")
  lastLocationLng        Float?    @map("last_location_lng")
  lastLocationAccuracy   Float?    @map("last_location_accuracy")
  /// The device's own word on that fix: true = the OS flagged it as a mock-location fix (Android),
  /// false = the OS says it was not, null = unknown (iOS, web, an older client). A true fix is not a
  /// position the server holds (lib/arrival-position.ts).
  lastLocationMocked     Boolean?  @map("last_location_mocked")
  lastLocationSource     String?   @map("last_location_source")
  lastLocationSeq        Int?      @map("last_location_seq")
  appState               String?   @map("app_state")
  platform               String?   @map("platform")
  appVersion             String?   @map("app_version")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  provider               Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([lastHeartbeatAt])
  @@index([activeSessionId])
  @@index([lastLocationAt])
  @@index([providerId, updatedAt])
  @@map("partner_presence")
}

model WalletTransaction {
  id                       String          @id @default(cuid())
  transactionNumber        String          @unique @map("transaction_number")
  userId                   String?         @map("user_id")
  providerId               String?         @map("provider_id")
  amount                   Float
  amountPaise              BigInt          @default(0) @map("amount_paise")
  walletBalanceBefore      Float           @map("wallet_balance_before")
  walletBalanceBeforePaise BigInt          @default(0) @map("wallet_balance_before_paise")
  walletBalanceAfter       Float           @map("wallet_balance_after")
  walletBalanceAfterPaise  BigInt          @default(0) @map("wallet_balance_after_paise")
  type                     WalletTxnType
  description              String
  reason                   String?
  referenceId              String?         @map("reference_id")
  referenceType            String?         @map("reference_type")
  status                   WalletTxnStatus @default(COMPLETED)
  expiresAt                DateTime?       @map("expires_at")
  idempotencyKey           String?         @unique @map("idempotency_key")
  metadata                 String?
  createdAt                DateTime        @default(now()) @map("created_at")
