  providerId           String           @unique @map("provider_id")
  policyVersion        String           @map("policy_version")
  overallScore         Float?           @map("overall_score")
  band                 PartnerScoreBand
  quality              Float?
  reliability          Float?
  completion           Float?
  onTime               Float?           @map("on_time")
  customerSatisfaction Float?           @map("customer_satisfaction")
  compliance           Float?
  safety               Float?
  qualityWeight        Float            @map("quality_weight")
  reliabilityWeight    Float            @map("reliability_weight")
  completionWeight     Float            @map("completion_weight")
  onTimeWeight         Float            @map("on_time_weight")
  csatWeight           Float            @map("csat_weight")
  complianceWeight     Float            @map("compliance_weight")
  safetyWeight         Float            @map("safety_weight")
