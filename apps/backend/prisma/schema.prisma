model Booking {
  /// Provenance. NULL = UNKNOWN. Nullable with no default on purpose: defaulting to REAL would
  /// silently relabel every historical row as genuine business data.
  dataOrigin                  DataOrigin?                  @map("data_origin")
  id                          String                       @id @default(cuid())
  bookingNumber               String                       @unique @map("booking_number")
  userId                      String                       @map("user_id")
  providerId                  String?                      @map("provider_id")
  serviceId                   String                       @map("service_id")
  addressId                   String                       @map("address_id")
  status                      BookingStatus                @default(PENDING)
  scheduledDate               DateTime                     @map("scheduled_date")
  scheduledTime               String?                      @map("scheduled_time")
  acceptedAt                  DateTime?                    @map("accepted_at")
  startedAt                   DateTime?                    @map("started_at")
  completedAt                 DateTime?                    @map("completed_at")
  cancelledAt                 DateTime?                    @map("cancelled_at")
  estimatedDuration           Int?                         @map("estimated_duration")
  /// Minutes the partner/customer slot reserves beyond the ±30-min buffer, frozen at creation (D1).
  /// NULL on bookings made before 2026-09-21 = the legacy fixed 60-minute block (never re-slotted).
  slotDurationMinutes         Int?                         @map("slot_duration_minutes")
  actualDuration              Int?                         @map("actual_duration")
  eta                         Int?
  description                 String?
  userNotes                   String?                      @map("user_notes")
  providerNotes               String?                      @map("provider_notes")
  baseAmount                  Float                        @map("base_amount")
  baseAmountPaise             BigInt                       @default(0) @map("base_amount_paise")
  discount                    Float                        @default(0)
  discountPaise               BigInt                       @default(0) @map("discount_paise")
  couponCode                  String?                      @map("coupon_code")
  /// Catalog snapshot of chosen add-ons at booking time: [{id,name,price}]
  addons                      Json?
  /// Server-priced selection snapshot: variant, quantity, unit price, audience.
  serviceSelection            Json?                        @map("service_selection")
  /// Catalogue version at book time. Live service edits must not rewrite this row.
  serviceConfigVersion        Int?                         @map("service_config_version")
  /// Immutable policy/content slice (inclusions, duration, material responsibility).
  serviceConfigSnapshot       Json?                        @map("service_config_snapshot")
  taxes                       Float                        @default(0)
  taxesPaise                  BigInt                       @default(0) @map("taxes_paise")
  finalAmount                 Float                        @map("final_amount")
  finalAmountPaise            BigInt                       @default(0) @map("final_amount_paise")
  tipAmount                   Float                        @default(0) @map("tip_amount")
  tipAmountPaise              BigInt                       @default(0) @map("tip_amount_paise")
  totalAmount                 Float                        @map("total_amount")
  totalAmountPaise            BigInt                       @default(0) @map("total_amount_paise")
  paymentStatus               PaymentStatus                @default(PENDING) @map("payment_status")
  paymentMethod               String?                      @map("payment_method")
  cancellationReason          String?                      @map("cancellation_reason")
  cancelledBy                 String?                      @map("cancelled_by")
  refundStatus                String?                      @map("refund_status")
  refundAmount                Float?                       @map("refund_amount")
  refundAmountPaise           BigInt?                      @map("refund_amount_paise")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  assignedAt                  DateTime?                    @map("assigned_at")
  enRouteAt                   DateTime?                    @map("en_route_at")
  arrivedAt                   DateTime?                    @map("arrived_at")
  /// Set when the customer's start PIN was verified — the gate for `start`.
  startOtpVerifiedAt          DateTime?                    @map("start_otp_verified_at")
  travelDurationMin           Int?                         @map("travel_duration_min")
  campaignDiscount            Float                        @default(0) @map("campaign_discount")
  campaignDiscountPaise       BigInt                       @default(0) @map("campaign_discount_paise")
  campaignId                  String?                      @map("campaign_id")
  premiumMatched              Boolean                      @default(false) @map("premium_matched")
  priorityServed              Boolean                      @default(false) @map("priority_served")
  queuePosition               Int?                         @map("queue_position")
  queuePriority               QueuePriority                @default(NORMAL) @map("queue_priority")
  queuedAt                    DateTime?                    @map("queued_at")
  waitTimeMs                  BigInt?                      @map("wait_time_ms")
  estimatedWaitTimeMs         BigInt?                      @map("estimated_wait_time_ms")
  priorityScore               Int                          @default(10) @map("priority_score")
  activityLogs                ActivityLog[]
  assignmentJob               AssignmentJob?
  address                     Address                      @relation(fields: [addressId], references: [id])
  campaign                    Campaign?                    @relation(fields: [campaignId], references: [id])
  provider                    Provider?                    @relation(fields: [providerId], references: [id])
  service                     Service                      @relation(fields: [serviceId], references: [id])
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponUsages                CouponUsage[]
  membershipCashbacks         MembershipCashback?
  membershipCouponRedemptions MembershipCouponRedemption[]
  payment                     Payment?
  rating                      Rating?
  startOtps                   BookingStartOtp[]
  supportTickets              SupportTicket[]
  tracking                    Tracking?
  jobEvidence                 JobEvidence[]
  conversation                BookingConversation?

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([providerId, status])
  @@index([queuePriority, status])
  @@index([campaignId])
  @@index([status, providerId, priorityScore, queuedAt])
  @@index([addressId])
  @@index([serviceId])
  @@map("bookings")
  idempotencyKeys             BookingIdempotencyKey[]
}

