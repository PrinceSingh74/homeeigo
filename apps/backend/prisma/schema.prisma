// HOMIGO — Production PostgreSQL schema (customer + partner + admin)
// Aligned with apps/web, apps/partner-web, apps/admin-panel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_USER
  CANCELLED_BY_PROVIDER
}

enum PaymentStatus {
  PENDING
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REFUNDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum BackgroundCheckStatus {
  NOT_DONE
  PENDING
  CLEARED
  FAILED
}

enum TrackingStatus {
  NOT_STARTED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
}

enum WalletTxnType {
  CREDIT
  DEBIT
  BONUS
  REFUND
  WITHDRAWAL
  REVERSAL
}

enum WalletTxnStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum QueuePriority {
  HIGH
  NORMAL
}

enum AssignmentJobStatus {
  PENDING
  DISPATCHED
  ACCEPTED
  REJECTED
  TIMEOUT
  REASSIGNED
  EXHAUSTED
  CANCELLED
}

enum AssignmentAttemptStatus {
  SENT
  ACCEPTED
  REJECTED
  TIMEOUT
  SUPERSEDED
}

enum MembershipCouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SupportPriorityLevel {
  HIGH
  NORMAL
  LOW
}

enum CampaignType {
  COUPON
  PROMOTION
  BUNDLE
  OFFER
  DISCOUNT
  CASHBACK
  FREE_SERVICE
  BONUS_HCOINS
  REFERRAL_BOOST
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  DISABLED
  EXPIRED
}

enum CashbackStatus {
  PENDING
  CREDITED
  REDEEMED
  REVERSED
}

enum PartnerRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

// ─── MODEL 1: User (customers, vendors, admins) ──────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phoneNumber String @unique @map("phone_number")

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  profileImage String? @db.Text @map("profile_image")
  bio        String? @db.Text
  dateOfBirth DateTime? @map("date_of_birth")
  gender     String?

  role UserRole @default(CUSTOMER)

  password           String
  passwordChangedAt  DateTime? @map("password_changed_at")
  passwordResetToken String?   @unique @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  emailVerificationToken   String?   @unique @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  isActive     Boolean @default(true) @map("is_active")
  isBanned     Boolean @default(false) @map("is_banned")
  bannedReason String? @map("banned_reason")
  bannedAt     DateTime? @map("banned_at")

  kycStatus          KycStatus @default(NOT_STARTED) @map("kyc_status")
  kycDocumentUrl     String?   @db.Text @map("kyc_document_url")
  kycDocumentType    String?   @map("kyc_document_type")
  kycDocumentNumber     String? @map("kyc_document_number")
  kycDocumentNumberHash String? @unique @map("kyc_document_number_hash")
  kycVerifiedAt      DateTime? @map("kyc_verified_at")
  kycRejectionReason String?   @db.Text @map("kyc_rejection_reason")

  defaultAddressId String? @map("default_address_id")
  preferredCity    String? @map("preferred_city")
  defaultLanguage  String  @default("en") @map("default_language")
  timezone         String  @default("Asia/Kolkata")

  darkMode               Boolean @default(false) @map("dark_mode")
  notificationsEnabled   Boolean @default(true) @map("notifications_enabled")
  emailNotifications     Boolean @default(true) @map("email_notifications")
  pushNotifications      Boolean @default(true) @map("push_notifications")
  smsNotifications       Boolean @default(true) @map("sms_notifications")

  walletBalance  Float  @default(0) @map("wallet_balance")
  walletCurrency String @default("INR") @map("wallet_currency")
  totalSpent     Float  @default(0) @map("total_spent")
  totalSaved     Float  @default(0) @map("total_saved")

  referralCode      String? @unique @map("referral_code")
  referredBy        String? @map("referred_by")
  referralCount     Int     @default(0) @map("referral_count")
  referralBonusUsed Boolean @default(false) @map("referral_bonus_used")

  lastLoginAt    DateTime? @map("last_login_at")
  lastActivityAt DateTime? @map("last_activity_at")
  loginCount     Int       @default(0) @map("login_count")

  addresses          Address[]
  bookings           Booking[]
  ratingsGiven       Rating[]
  walletTransactions WalletTransaction[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  otps               OTP[]
  passwordHistories  PasswordHistory[]
  aiConversations    AiConversation[]
  supportTickets     SupportTicket[]
  activityLogs       ActivityLog[]
  payments           Payment[]
  provider           Provider?
  devices            UserDevice[]
  subscriptions      UserSubscription[]
  referralsMade        ReferralTransaction[] @relation("ReferralsMade")
  referralsReceived    ReferralTransaction[] @relation("ReferralReceived")
  referralCommissions  ReferralCommission[]  @relation("RefCommissionEarned")
  referralWithdrawals  ReferralWithdrawal[]
  hcoinWallet          HCoinWallet?
  hcoinTransactions    HCoinTransaction[]
  giftCardsPurchased   GiftCard[]            @relation("GiftPurchaser")
  giftCardsReceived    GiftCard[]            @relation("GiftRecipient")
  giftCardTransactions GiftCardTransaction[]
  transfersSent        WalletTransfer[]      @relation("TransferSender")
  transfersReceived    WalletTransfer[]      @relation("TransferRecipient")
  benefitUsages        MembershipBenefitUsage[]
  membershipCashbacks  MembershipCashback[]
  providerMatchScores  ProviderMatchScore[]
  couponUsages         CouponUsage[]
  membershipCouponRedemptions MembershipCouponRedemption[]
  fraudSignals         FraudSignal[]
  fraudRiskScore       FraudRiskScore?
  fraudAlerts          FraudAlert[]
  consentRecords       ConsentRecord[]
  partnerRegistrationSessions PartnerRegistrationSession[]

  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([phoneNumber])
  @@index([kycStatus])
  @@index([isActive])
  @@index([isBanned])
  @@index([role])
  @@index([createdAt])
  @@index([referralCode])
  @@index([deletedAt])
  @@map("users")
}

model UserDevice {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String       @map("device_id")
  platform       PushPlatform
  deviceName     String?      @map("device_name")
  appVersion     String?      @map("app_version")
  osVersion      String?      @map("os_version")
  expoPushToken  String       @unique @map("expo_push_token")
  tokenUpdatedAt DateTime     @default(now()) @map("token_updated_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  isActive       Boolean      @default(true) @map("is_active")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("user_devices")
}

model OTP {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String   @map("phone_number")
  otpHash     String   @map("otp_hash")
  expiresAt   DateTime @map("expires_at")
  isUsed      Boolean  @default(false) @map("is_used")
  attemptCount Int     @default(0) @map("attempt_count")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt])
  @@index([expiresAt])
  @@map("otps")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("password_histories")
}

// ─── MODEL 2: Provider (service professionals / partners) ────────────────────

model Provider {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName    String? @map("business_name")
  businessLicense String? @unique @map("business_license")
  taxId           String? @map("tax_id")
  taxIdHash       String? @unique @map("tax_id_hash")

  serviceCategories String[] @map("service_categories")
  serviceRegions    String[] @map("service_regions")
  bio               String?  @db.Text

  isVerified        Boolean   @default(false) @map("is_verified")
  verificationDate  DateTime? @map("verification_date")
  verificationNotes String?   @db.Text @map("verification_notes")

  documents      ProviderDocument[]
  certifications String[]

  backgroundCheckStatus BackgroundCheckStatus @default(NOT_DONE) @map("background_check_status")
  backgroundCheckDate   DateTime?             @map("background_check_date")

  profileImage    String? @db.Text @map("profile_image")
  rating          Float   @default(0)
  totalReviews    Int     @default(0) @map("total_reviews")
  ratingBreakdown String? @db.Text @map("rating_breakdown")

  badges String[] @default([])

  reviews Rating[] @relation("ProviderReviews")

  totalBookings     Int @default(0) @map("total_bookings")
  completedBookings Int @default(0) @map("completed_bookings")
  cancelledBookings Int @default(0) @map("cancelled_bookings")
  rejectedBookings  Int @default(0) @map("rejected_bookings")

  completionRate   Float @default(0) @map("completion_rate")
  responseRate     Float @default(0) @map("response_rate")
  cancellationRate Float @default(0) @map("cancellation_rate")
  onTimeRate       Float @default(0) @map("on_time_rate")
  acceptanceRate   Float @default(0) @map("acceptance_rate")

  avgResponseTime   Float @default(0) @map("avg_response_time")
  avgCompletionTime Float @default(0) @map("avg_completion_time")

  isOnline      Boolean   @default(false) @map("is_online")
  onlineSince   DateTime? @map("online_since")
  lastSeenAt    DateTime? @map("last_seen_at")
  currentStatus String    @default("offline") @map("current_status")

  workingHoursStart String?  @map("working_hours_start")
  workingHoursEnd   String?  @map("working_hours_end")
  workingDays       String[] @map("working_days")

  walletBalance     Float @default(0) @map("wallet_balance")
  reservedBalance   Float @default(0) @map("reserved_balance")
  totalEarnings     Float @default(0) @map("total_earnings")
  thisMonthEarnings Float @default(0) @map("this_month_earnings")
  thisWeekEarnings  Float @default(0) @map("this_week_earnings")
  commissionRate    Float @default(20) @map("commission_rate")

  earnings             Earning[]
  withdrawals          Withdrawal[]
  walletTransactions   WalletTransaction[]
  walletReservations   ProviderWalletReservation[]

  bankAccountHolder     String? @map("bank_account_holder")
  bankAccountNumber     String? @map("bank_account_number")
  bankAccountNumberHash String? @unique @map("bank_account_number_hash")
  bankIfscCode          String? @map("bank_ifsc_code")
  bankName              String? @map("bank_name")

  paymentMethodPreference String @default("bank_transfer") @map("payment_method_preference")
  upiId                   String? @map("upi_id")
  upiIdHash               String? @unique @map("upi_id_hash")

  currentLocation Location?
  locationHistory LocationHistory[]

  isActive      Boolean @default(true) @map("is_active")
  isBanned      Boolean @default(false) @map("is_banned")
  bannedReason  String? @map("banned_reason")
  bannedAt      DateTime? @map("banned_at")
  isApproved    Boolean @default(false) @map("is_approved")
  approvalNotes String? @db.Text @map("approval_notes")

  registrationStatus PartnerRegistrationStatus @default(PENDING) @map("registration_status")
  registeredAt       DateTime                  @default(now()) @map("registered_at")
  partnerApprovedAt  DateTime?                 @map("partner_approved_at")
  rejectedAt         DateTime?                 @map("rejected_at")
  rejectionReason    String?                   @db.Text @map("rejection_reason")
  city               String?
  experienceYears    Int                       @default(0) @map("experience_years")
  panNumber          String? @map("pan_number")
  panNumberHash      String? @unique @map("pan_number_hash")
  aadharNumber       String? @map("aadhar_number")
  aadharNumberHash   String? @unique @map("aadhar_number_hash")
  adminApprovedBy    String?                   @map("admin_approved_by")

  partnerBackgroundCheck PartnerBackgroundCheck?

  bookings            Booking[]
  providerMatchScores ProviderMatchScore[]
  assignmentAttempts  AssignmentAttempt[]
  supportTickets      SupportTicket[]
  activityLogs        ActivityLog[]
  notifications       Notification[]

  pushTokens String[] @map("push_tokens")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isOnline])
  @@index([rating])
  @@index([isVerified])
  @@index([isApproved])
  @@index([registrationStatus])
  @@index([isActive])
  @@index([completionRate])
  @@index([createdAt])
  @@map("providers")
}

// ─── MODEL 3: Service ────────────────────────────────────────────────────────

model Service {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  description         String  @db.Text
  detailedDescription String? @db.Text @map("detailed_description")

  category    String
  subcategory String?

  basePrice         Float  @map("base_price")
  minPrice          Float? @map("min_price")
  maxPrice          Float? @map("max_price")
  currency          String @default("INR")
  estimatedDuration Int    @map("estimated_duration")
  durationRange     String? @map("duration_range")

  isActive   Boolean @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured")
  isPopular  Boolean @default(false) @map("is_popular")
  isPromoted Boolean @default(false) @map("is_promoted")

  popularity   Int @default(0)
  bookingCount Int @default(0) @map("booking_count")

  icon      String?  @db.Text
  images    String[]
  thumbnail String?  @db.Text

  includedServices  String[] @map("included_services")
  excludedServices  String[] @map("excluded_services")
  requirements      String[]

  availableCities   String[] @map("available_cities")
  unavailableCities String[] @map("unavailable_cities")

  tags           String[]
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoKeywords    String? @map("seo_keywords")

  pricingModel String @default("fixed") @map("pricing_model")

  // Entitlement gate: when true, only users with an active membership granting
  // PREMIUM_ONLY_ACCESS may book this service (enforced server-side at booking).
  premiumOnly Boolean @default(false) @map("premium_only")

  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([popularity])
  @@index([slug])
  @@map("services")
}

// ─── MODEL 4: Address ────────────────────────────────────────────────────────

model Address {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  state        String
  zipCode      String  @map("zip_code")
  country      String  @default("India")

  fullAddress String @default("") @db.Text @map("full_address")

  latitude  Float
  longitude Float
  placeId   String? @map("place_id")

  type String @default("residential")

  isDefault        Boolean @default(false) @map("is_default")
  isBillingAddress Boolean @default(false) @map("is_billing_address")

  landmark            String?
  buildingName        String? @map("building_name")
  flatNumber          String? @map("flat_number")
  specialInstructions String? @db.Text @map("special_instructions")

  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")

  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([city])
  @@index([isDefault])
  @@map("addresses")
}

// ─── MODEL 5: Booking ────────────────────────────────────────────────────────

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique @map("booking_number")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String?  @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  serviceId String @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  addressId String  @map("address_id")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  status BookingStatus @default(PENDING)

  scheduledDate DateTime  @map("scheduled_date")
  scheduledTime String?   @map("scheduled_time")

  acceptedAt  DateTime? @map("accepted_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  estimatedDuration Int? @map("estimated_duration")
  actualDuration    Int? @map("actual_duration")
  eta               Int?

  description   String? @db.Text
  userNotes     String? @db.Text @map("user_notes")
  providerNotes String? @db.Text @map("provider_notes")

  baseAmount  Float   @map("base_amount")
  discount    Float   @default(0)
  couponCode  String? @map("coupon_code")
  campaignId        String?       @map("campaign_id")
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignDiscount  Float         @default(0) @map("campaign_discount")
  queuePriority     QueuePriority @default(NORMAL) @map("queue_priority")
  queuePosition       Int?          @map("queue_position")
  priorityScore       Int           @default(10) @map("priority_score")
  estimatedWaitTimeMs Int?          @map("estimated_wait_time_ms")
  queuedAt            DateTime?     @map("queued_at")
  assignedAt          DateTime?     @map("assigned_at")
  waitTimeMs          Int?          @map("wait_time_ms")
  priorityServed      Boolean       @default(false) @map("priority_served")
  premiumMatched    Boolean       @default(false) @map("premium_matched")
  taxes       Float   @default(0)
  finalAmount Float   @map("final_amount")
  tipAmount   Float   @default(0) @map("tip_amount")
  totalAmount Float   @map("total_amount")

  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod String?       @map("payment_method")

  payment Payment?

  cancellationReason String? @map("cancellation_reason")
  cancelledBy        String? @map("cancelled_by")
  refundStatus       String? @map("refund_status")
  refundAmount       Float?  @map("refund_amount")

  rating   Rating?
  tracking Tracking?

  supportTickets SupportTicket[]
  activityLogs     ActivityLog[]
  membershipCashbacks MembershipCashback[]
  couponUsages        CouponUsage[]
  membershipCouponRedemptions MembershipCouponRedemption[]
  assignmentJob       AssignmentJob?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([bookingNumber])
  @@index([userId, createdAt])
  @@index([providerId, status])
  @@index([queuePriority, status])
  @@index([campaignId])
  @@index([status, providerId, priorityScore, queuedAt])
  @@map("bookings")
}

// ─── MODEL 6: Payment ────────────────────────────────────────────────────────

model Payment {
  id        String @id @default(cuid())
  bookingId String @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount     Float
  amountPaid Float  @default(0) @map("amount_paid")
  currency   String @default("INR")

  paymentMethod String @map("payment_method")

  razorpayOrderId   String  @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")
  razorpayErrorCode String? @map("razorpay_error_code")
  razorpayErrorDescription String? @map("razorpay_error_description")

  status PaymentStatus @default(INITIATED)

  refundedAmount   Float   @default(0) @map("refunded_amount")
  refundReason     String? @map("refund_reason")
  razorpayRefundId String? @unique @map("razorpay_refund_id")
  refundStatus     String? @map("refund_status")

  receiptUrl    String? @db.Text @map("receipt_url")
  invoiceNumber String? @unique @map("invoice_number")

  metadata String? @db.Text
  notes    String?

  settledAt     DateTime? @map("settled_at")
  settlementId  String?   @map("settlement_id")
  settledAmount Float?    @map("settled_amount")

  settlements PaymentSettlement[]

  initiatedAt DateTime  @default(now()) @map("initiated_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@map("payments")
}

// ─── MODEL 7: Rating ─────────────────────────────────────────────────────────

model Rating {
  id        String @id @default(cuid())
  bookingId String @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)

  stars Int @map("rating")

  reviewText  String? @db.Text @map("review_text")
  shortReview String? @map("short_review")

  ratingBreakdown String? @db.Text @map("rating_breakdown")

  liked        String[]
  couldImprove String[] @map("could_improve")

  photos String[]
  videos String[]

  tipAmount Float @default(0) @map("tip_amount")

  helpfulCount   Int @default(0) @map("helpful_count")
  unhelpfulCount Int @default(0) @map("unhelpful_count")

  providerResponse String?   @db.Text @map("provider_response")
  respondedAt      DateTime? @map("responded_at")

  isPublic    Boolean @default(true) @map("is_public")
  isAnonymous Boolean @default(false) @map("is_anonymous")
