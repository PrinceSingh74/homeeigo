/// Section 07 partner-to-partner referral. Distinct from customer ReferralTransaction.
/// References PartnerLead (Section 01) — does not duplicate acquisition state.
model PartnerReferral {
  id                  String                         @id @default(cuid())
  referrerProviderId  String                         @map("referrer_provider_id")
  referredLeadId      String?                        @unique @map("referred_lead_id")
  referredProviderId  String?                        @unique @map("referred_provider_id")
  referralCode        String                         @map("referral_code")
  status              PartnerReferralStatus          @default(INVITED)
  source              PartnerReferralSource          @default(PARTNER_REFERRAL)
  campaign            String?
  qualificationStatus PartnerReferralQualStatus      @default(PENDING) @map("qualification_status")
  reviewStatus        PartnerReferralReviewStatus    @default(NONE) @map("review_status")
  successfulJobs      Int                            @default(0) @map("successful_jobs")
  invitedAt           DateTime                       @default(now()) @map("invited_at")
  registeredAt        DateTime?                      @map("registered_at")
  verifiedAt          DateTime?                      @map("verified_at")
  trainingAt          DateTime?                      @map("training_at")
  activatedAt         DateTime?                      @map("activated_at")
  firstJobAt          DateTime?                      @map("first_job_at")
  qualifiedAt         DateTime?                      @map("qualified_at")
  rewardedAt          DateTime?                      @map("rewarded_at")
  blockedReason       String?                        @map("blocked_reason")
  expiresAt           DateTime?                      @map("expires_at")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  referrer            Provider                       @relation("PartnerReferralsMade", fields: [referrerProviderId], references: [id], onDelete: Cascade)
  referred            Provider?                      @relation("PartnerReferralReceived", fields: [referredProviderId], references: [id], onDelete: SetNull)
  lead                PartnerLead?                   @relation(fields: [referredLeadId], references: [id], onDelete: SetNull)
  reward              PartnerReferralReward?
  history             PartnerReferralStatusHistory[]
  signals             PartnerReferralAbuseSignal[]

  @@index([referrerProviderId, status])
  @@index([referralCode])
  @@index([status])
  @@index([qualificationStatus])
  @@index([reviewStatus])
  @@index([createdAt])
  @@map("partner_referrals")
}

