// Phase 16.3 — Geofencing (Float/haversine circular zones; NO PostGIS).
// A geofence is a circle (centre + radius). Containment = haversine ≤ radius. Used for
// service-area gating, society/premium zones, and enter/exit analytics.
model Geofence {
  id                String          @id @default(cuid())
  name              String
  zoneType          String          @default("SERVICE_ZONE") @map("zone_type") // SERVICE_ZONE | SOCIETY | PREMIUM_AREA | CITY
  shape             String          @default("CIRCLE") // CIRCLE | POLYGON
  city              String?
  state             String?
  centerLat         Float           @map("center_lat")
  centerLng         Float           @map("center_lng")
  radiusMeters      Float           @map("radius_meters")
  // POLYGON shapes: ordered ring of vertices [{lat,lng}, ...]; null for circles.
  polygon           Json?
  serviceCategories String[]        @default([]) @map("service_categories")
  surgeMultiplier   Float           @default(1) @map("surge_multiplier")
  metadata          String?
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  events            GeofenceEvent[]

  @@index([isActive])
  @@index([city, state])
  @@index([zoneType])
  @@map("geofences")
}

