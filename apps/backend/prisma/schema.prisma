enum AiToolRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiToolStatus {
  ACTIVE
  DEPRECATED
  DISABLED
}

enum AiToolPolicyDecision {
  ALLOW
  DENY
  /// The acting user must see the consequences and agree. Not a second human.
  REQUIRES_CONFIRMATION
  REQUIRES_APPROVAL
}

enum AiToolExecutionStatus {
  PENDING
  PENDING_APPROVAL
  RUNNING
  SUCCESS
  FAILED
  DENIED
  TIMEOUT
  /// The call may or may not have taken effect. Reconcile against the downstream system;
  /// never retry and never re-approve on the assumption that nothing happened.
  INDETERMINATE
  CANCELLED
}

enum AiToolApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  /// Terminal: this approval has authorised exactly one execution and cannot be reused.
  CONSUMED
}

enum AiToolApprovalMode {
