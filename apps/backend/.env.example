# Backend environment template

NODE_ENV=development
APP_ENV=dev
PORT=3000
HOST=localhost

# Matches docker-compose.yml (postgres / homigo_dev / homigo_db)
DATABASE_URL=postgresql://postgres:homigo_dev@localhost:5432/homigo_db
REDIS_URL=redis://localhost:6379

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

APPLE_REDIRECT_URI=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_SECRET=change-me-otp-secret

# Registration: require SMS OTP before account creation (matches Part 1 flow). Set false for local dev without Twilio.
REGISTER_REQUIRE_OTP=false

FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

LOG_LEVEL=debug
