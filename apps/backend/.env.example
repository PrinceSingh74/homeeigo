# Backend environment template

NODE_ENV=development
APP_ENV=dev
PORT=3000
HOST=localhost

# Matches docker-compose.yml (postgres / homigo_dev / homigo_db)
DATABASE_URL=postgresql://postgres:homigo_dev@localhost:5433/homigo_db
# Redis is OPTIONAL. Leave REDIS_URL empty for single-instance dev — rate limiting
# falls back to in-memory automatically (you do NOT need Redis running locally).
# When set AND reachable, API rate limits, distributed locks, and WebSocket
# fan-out work across multiple backend instances. Local docker-compose Redis:
# REDIS_URL=redis://localhost:6379
REDIS_URL=
# How many reconnect attempts before giving up and using in-memory (default 3).
REDIS_MAX_RETRIES=3
# Periodic PING interval (ms) to detect a silently dropped Redis socket (default 30000).
REDIS_HEALTH_CHECK_INTERVAL=30000
# Set to "cluster" only when REDIS_URL points at a Redis Cluster (purely a label
# for observability/topology reporting — a single managed HA endpoint stays "standalone").
REDIS_TOPOLOGY=standalone

# Observability — Sentry error & performance reporting. OPTIONAL and fail-safe:
# leave SENTRY_DSN empty and the app behaves exactly as before (no telemetry, no-op).
# When set, only server faults (5xx / DB outages) are reported — never 4xx noise.
SENTRY_DSN=
# Shown on every Sentry event so you can tie errors to a deploy. Defaults to homigo-backend@1.0.0.
APP_VERSION=homigo-backend@1.0.0
# Emit OpenTelemetry-compatible span JSON to stdout (picked up by log shippers / OTEL collector).
OTEL_EXPORTER=stdout
# Scheduled DB backups via maintenance cron (requires backup:db script).
ENABLE_SCHEDULED_BACKUPS=false
# Log ring buffer size and archival retention (days).
LOG_RING_BUFFER_SIZE=2000
ARCHIVE_RETENTION_DAYS=90
# Max providers loaded per matching query (scalability guard).
MATCHING_MAX_CANDIDATES=500

# Generate strong secrets with: openssl rand -hex 32
# In production the server refuses to start with weak/placeholder secrets.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Encryption at rest (AES-256-GCM) for sensitive PII. MUST be 64 hex characters.
# Generate with: openssl rand -hex 32
# Required in production; in dev a key is derived from JWT_SECRET if unset.
ENCRYPTION_KEY=

# Transport security. Set FORCE_HTTPS=true behind a TLS-terminating proxy to
# redirect plain HTTP and emit HSTS preload headers.
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

APPLE_REDIRECT_URI=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_SECRET=change-me-otp-secret
# Max OTP requests per phone per hour. Prod is hard-capped at 3; this raises the
# dev ceiling for repeated testing (default 50 when unset).
OTP_HOURLY_LIMIT=50

# Registration: require SMS OTP before account creation (matches Part 1 flow). Set false for local dev without Twilio.
REGISTER_REQUIRE_OTP=false

FRONTEND_URL=http://localhost:3001
MOBILE_DEEP_LINK_BASE=homigo:/
PARTNER_WEB_URL=http://localhost:3002
BACKEND_URL=http://localhost:3000

# Partner self-registration
ADMIN_EMAIL=admin@homigo.com
FILE_UPLOAD_DIR=./uploads/partner-documents
MAX_FILE_SIZE=5242880

# Razorpay (payments + wallet top-up). Dev mode works without keys (mock order IDs).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard -> Webhooks. Required to enable /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Resend (https://resend.com). Leave empty in dev to log emails to console instead.
RESEND_API_KEY=
EMAIL_FROM="HOMIGO <noreply@homigo.com>"
EMAIL_REPLY_TO=
SUPPORT_EMAIL=support@homigo.com

LOG_LEVEL=debug

# Readiness: optional resident-memory ceiling (MB). When set, /ready reports
# not_ready if RSS exceeds it. Leave unset to never gate on memory (recommended
# under Bun, where heapUsed/heapTotal ratios are unreliable). Container OOM limits
# remain the real backstop.
MAX_RSS_MB=

# Backups (scripts/backup-db.ts). Local dev dumps run inside the Postgres
# container; production dumps the DATABASE_URL target with pg_dump on PATH.
BACKUP_DOCKER_CONTAINER=homigo-postgres
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional offsite copy via the AWS SDK (no aws CLI needed). Leave empty for local-only.
# Put REAL values only in .env (gitignored) — never here.
# Use an IAM user scoped to just s3:PutObject on this bucket (least privilege).
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
