    {
      "id": 94,
      "title": "SLO: % req < 500ms",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_bucket{le=\"0.5\"}[15m]))/clamp_min(sum(rate(http_request_duration_seconds_count[15m])),0.001)*100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
