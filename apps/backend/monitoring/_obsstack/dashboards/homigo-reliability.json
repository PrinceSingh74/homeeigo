    {
      "id": 97,
      "title": "Availability % (non-5xx)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "(1-(sum(rate(http_requests_total{status=~\"5..\"}[15m])) or vector(0))/clamp_min(sum(rate(http_requests_total[15m])),0.001))*100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
