{
  "uid": "homigo-ioc-automation",
  "title": "22 \u00b7 IOC \u2014 Automation",
  "tags": [
    "homigo",
    "enterprise",
    "ioc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Intelligence Operations",
      "tags": [
        "ioc"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 401,
      "title": "Workflow inventory",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 402,
      "title": "Workflows LIVE",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_workflow_definitions{status=\"ACTIVE\",mode=\"LIVE\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Active definitions that actually act. A LIVE workflow can send, escalate and mutate; a SHADOW one records what it would have done. This platform currently runs everything in shadow, and that is a governance state, not a fault."
    },
    {
      "id": 403,
      "title": "Workflows SHADOW",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_workflow_definitions{mode=\"SHADOW\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Definitions in shadow mode across every status. They observe and record; they do not act."
    },
    {
      "id": 404,
      "title": "Definitions (all states)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "homigo_workflow_definitions_total",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Every definition row, including DRAFT, DISABLED and ARCHIVED. Not a count of executions."
    },
    {
      "id": 405,
      "title": "Scheduled jobs pending",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_scheduled_jobs_pending",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Jobs queued and not yet run. Zero here is an authoritative measured zero."
    },
    {
      "id": 406,
      "title": "Executions",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 407,
      "title": "Executions (all instances)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_workflow_instances)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Workflow instances across every terminal and non-terminal state, read from the instance table rather than from an increment counter \u2014 so the number survives a process restart."
    },
    {
      "id": 408,
      "title": "Completed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_workflow_instances{status=\"COMPLETED\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Instances that ran to completion. SKIPPED is a deliberate stop and is counted separately."
    },
    {
      "id": 409,
      "title": "Failed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_workflow_instances{status=\"FAILED\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Instances that ended in failure. CANCELLED is a decision, not a failure, and is not counted here."
    },
    {
      "id": 410,
      "title": "Step retries",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_workflow_step_retries_total",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Step runs past their first attempt, counted from durable state. A retry is not a failure: a retried step that then succeeded is a recovery, and the failure panel is separate."
    },
    {
      "id": 411,
      "title": "Job age and liveness",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 412,
      "title": "Oldest RUNNING instance age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_workflow_instances_running_age_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "How long the longest-running instance has been running. Deliberately an age and not a 'stuck' count: this project defines no stuck-job threshold, so naming one here would put a number in front of an operator that no policy stands behind. STUCK_JOB_THRESHOLD_UNSET."
    },
    {
      "id": 413,
      "title": "Scheduled job lag",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_scheduled_job_lag_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "How overdue the oldest pending scheduled job is. Same reasoning: measured, not thresholded."
    },
    {
      "id": 414,
      "title": "WAITING (parked by design)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_workflow_instances{status=\"WAITING\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Instances parked until their next run time, with a scheduled job already queued. Waiting is healthy and must not be read as stuck."
    },
    {
      "id": 415,
      "title": "Detail",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 416,
      "title": "Instances by state over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (homigo_workflow_instances)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{status}}"
        }
      ],
      "description": "State distribution over the dashboard time range."
    },
    {
      "id": 417,
      "title": "Definitions by status and mode",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        }
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (status, mode) (homigo_workflow_definitions)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "description": "The full inventory grid. LIVE vs SHADOW is the column that decides whether anything can act."
    },
    {
      "id": 418,
      "title": "Backlog and lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "homigo_scheduled_jobs_pending",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "scheduled pending"
        },
        {
          "expr": "homigo_scheduled_job_lag_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "job lag (s)"
        },
        {
          "expr": "homigo_workflow_instances_running_age_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "oldest running (s)"
        }
      ],
      "description": "Queue depth beside queue age \u2014 depth alone cannot tell a busy scheduler from a stalled one."
    }
  ]
}
