  "panels": [
    {
      "id": 401,
      "title": "Platform serviceability",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 402,
      "title": "ML platform",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT SERVICEABLE",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "SERVICEABLE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "ml_platform_serviceable",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Whether the platform is in a state where its predictions describe the present. False means callers should use their deterministic fallback \u2014 it does not mean the models are absent."
    },
    {
      "id": 403,
      "title": "ETL pipeline",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red",
                  "index": 0
                },
                "0.5": {
                  "text": "WARN",
                  "color": "yellow",
                  "index": 1
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "ml_platform_check_state{check=\"etl_pipeline\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Whether the pipeline feeding every model has succeeded recently. Read from execution history, not a heartbeat."
    },
