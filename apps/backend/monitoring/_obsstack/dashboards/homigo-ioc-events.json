{
  "uid": "homigo-ioc-events",
  "title": "21 \u00b7 IOC \u2014 Events",
  "tags": [
    "homigo",
    "enterprise",
    "ioc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Intelligence Operations",
      "tags": [
        "ioc"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 401,
      "title": "Throughput",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 402,
      "title": "Events / sec (processed)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(homigo_consumer_processed_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Rate of events actually handled by consumers, over a 5-minute window. This is processing throughput, not publication: an event handled by three consumers counts three times here, which is what consumer capacity planning needs. Publication volume is the panel to the right."
    },
    {
      "id": 403,
      "title": "Events published / sec",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(homigo_outbox_publish_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Rate of events written to the outbox. One publication may fan out to several consumers."
    },
    {
      "id": 404,
      "title": "Events processed (total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_consumer_processed_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Cumulative since process start. Counters reset on restart; use the rate panels for trend."
    },
    {
      "id": 405,
      "title": "Processing failures (total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_consumer_failed_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Consumer handler failures. A failure is not a retry and not a skip \u2014 those are separate series."
    },
    {
      "id": 406,
      "title": "Backlog and dead letters",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 407,
      "title": "Outbox pending",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_outbox_pending",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Events written but not yet dispatched. This is live backlog from the outbox table, not a count of historical rows. Zero here is an authoritative measured zero."
    },
    {
      "id": 408,
      "title": "Oldest pending age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_outbox_oldest_pending_age_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Age of the oldest undispatched event. Backlog depth alone cannot distinguish a busy moment from a stalled dispatcher; age can. No alert threshold is defined for this \u2014 see the runbook, ALERT_POLICY_UNSET."
    },
    {
      "id": 409,
      "title": "DLQ unresolved",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "homigo_dlq_unresolved",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Dead letters awaiting a human decision. The dead-letter path is real in this platform \u2014 this is not a placeholder metric."
    },
    {
      "id": 410,
      "title": "DLQ persist failures",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(homigo_dlq_persist_failed_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Events that could not even be written to the dead-letter store. Non-zero means events are being lost rather than parked, which is strictly worse than a growing DLQ."
    },
    {
      "id": 411,
      "title": "Detail",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 412,
      "title": "Processing rate by consumer",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum by (consumer) (rate(homigo_consumer_processed_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{consumer}}"
        }
      ],
      "description": "Per-consumer throughput. A consumer flat at zero while others move is the shape of a stuck handler."
    },
    {
      "id": 413,
      "title": "Failures, retries and skips",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "sum by (consumer) (rate(homigo_consumer_failed_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "failed \u00b7 {{consumer}}"
        },
        {
          "expr": "sum by (consumer) (rate(homigo_consumer_retry_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "retry \u00b7 {{consumer}}"
        },
        {
          "expr": "sum by (consumer) (rate(homigo_consumer_skipped_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "skipped \u00b7 {{consumer}}"
        }
      ],
      "description": "Three distinct outcomes kept apart on purpose: a retry is not a failure, and a skip is a deliberate no-op rather than an error."
    },
    {
      "id": 414,
      "title": "Consumer latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(homigo_consumer_metrics_duration_seconds_bucket[5m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(homigo_consumer_metrics_duration_seconds_bucket[5m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(homigo_consumer_metrics_duration_seconds_bucket[5m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p99"
        }
      ],
      "description": "Handler processing duration, not end-to-end event age. Percentiles over a small sample are unstable \u2014 read them alongside the rate panels rather than alone."
    },
    {
      "id": 415,
      "title": "Events by domain",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        }
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (domain) (homigo_event_by_domain_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{domain}}",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Publication volume per domain, cumulative since process start."
    },
    {
      "id": 416,
      "title": "Dead letters by consumer and event type",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        }
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (consumer, event_type) (homigo_dlq_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Where events are dying. Empty is the healthy state and renders as NO DATA rather than as a zero row."
    }
  ]
}
