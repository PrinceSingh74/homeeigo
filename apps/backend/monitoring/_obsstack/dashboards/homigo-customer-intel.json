      "id": 169,
      "title": "Avg CLV (₹)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        }
      },
      "targets": [
        {
          "expr": "customer_clv_sum/clamp_min(customer_clv_count,1)",
          "refId": "A",
          "datasource": {
