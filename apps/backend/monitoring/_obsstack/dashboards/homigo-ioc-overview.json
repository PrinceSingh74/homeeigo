    {
      "id": 444,
      "title": "Backend scrape target",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=\"homigo-backend\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Whether Prometheus can reach the backend at all. Every panel above reads NO DATA rather than zero when this is DOWN, so a dead exporter cannot masquerade as a quiet platform."
    },
    {
      "id": 445,
      "title": "Telemetry data age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA"
        }
      },
      "targets": [
        {
          "expr": "time() - timestamp(homigo_outbox_pending)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Age of the newest sample actually published by the backend exporter. Deliberately anchored on a real exporter series rather than on `up`: Prometheus keeps recording a scrape attempt every 10s after the exporter dies, so `timestamp(up)` stays fresh through an outage and would show seconds-old telemetry while no data had arrived for minutes. When the exporter stops, this grows and then reads NO DATA once Prometheus stale-marks the series \u2014 which, beside a DOWN target, is unambiguous."
    },
    {
      "id": 446,
      "title": "Reading this board",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**NO DATA is not zero.** Panels render `NO DATA` when a series is absent and a number only when something was measured. A stat showing 0 means the platform measured zero; a stat showing NO DATA means nothing was collected, and the telemetry-health row above says which.\n\nUse the **Intelligence Operations** dropdown, top left, to reach the Events, Automation, AI and ML boards. Each panel carries a description explaining its exact semantics \u2014 hover the title."
      }
    }
  ]
