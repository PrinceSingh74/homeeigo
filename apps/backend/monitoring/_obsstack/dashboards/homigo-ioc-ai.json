          "noValue": "NO DATA"
        }
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (provider, reason) (homigo_ai_provider_failures_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
