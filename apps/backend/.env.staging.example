# STAGING environment template — copy to .env.staging (gitignored) and fill secrets
# via your secret manager. Never commit real values.
#
# Local isolated stack: docker compose -f docker-compose.staging.yml up -d
# Run backend:  HOMIGO_STAGING=1 bun run src/index.ts   (PowerShell: $env:HOMIGO_STAGING="1"; bun run src/index.ts)
# Cloud staging: inject these via GitHub Environment / GCP Secret Manager / K8s Secret.

NODE_ENV=production
APP_ENV=staging
PORT=3010
HOST=0.0.0.0

# Isolated staging PostgreSQL (docker-compose.staging.yml — NOT dev port 5433)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5434/homigo_staging_db
PRISMA_CONNECTION_LIMIT=15
PRISMA_POOL_TIMEOUT=20

# Isolated staging Redis (NOT dev port 6379)
REDIS_URL=redis://localhost:6380
REDIS_TOPOLOGY=standalone

# Observability — tag staging distinctly in Sentry/Grafana/Prometheus
SENTRY_ENVIRONMENT=staging
SENTRY_DSN=
APP_VERSION=homigo-backend@staging

# Auth — MUST differ from production (generate: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_STAGING_JWT
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_JWT_REFRESH
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FOR_STAGING_ENCRYPTION_KEY________________
OTP_SECRET=CHANGE_ME_STAGING_OTP

# Razorpay TEST mode only — keys start with rzp_test_
# Do NOT set RAZORPAY_ACCOUNT_NUMBER in staging (blocks live payouts).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email — leave empty to log-only, or use Resend test/sandbox key
RESEND_API_KEY=
EMAIL_FROM="HOMIGO Staging <staging-noreply@homigo.com>"

# SMS — leave empty in staging (OTP logs to console); never use production Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
REGISTER_REQUIRE_OTP=false

# Storage — separate bucket or local-only (recommended for staging)
AWS_S3_BUCKET=
LOCAL_UPLOAD_ROOT=./uploads-staging

# Staging URLs (adjust when DNS is provisioned)
BACKEND_URL=http://localhost:3010
FRONTEND_URL=http://localhost:3001
PARTNER_WEB_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3003
ALLOWED_ORIGINS=https://staging.homigo.com,https://staging-api.homigo.com,https://staging-admin.homigo.com,https://staging-partner.homigo.com

# Phase 0 event infrastructure — OFF until Step 7 schema PASS (Stage C).
# Stage D: set STAGING_EVENTS_CERTIFICATION=1 then enable flags incrementally.
STAGING_EVENTS_CERTIFICATION=0
EVENTS_OUTBOX_ENABLED=false
EVENTS_CONSUMERS_ENABLED=false
EVENTS_BOOKING_ENABLED=false
EVENTS_PAYMENT_ENABLED=false
EVENTS_TRACKING_ENABLED=false
EVENTS_PARTNER_ENABLED=false

# Scheduled backups off in staging (recreate-from-migration strategy)
ENABLE_SCHEDULED_BACKUPS=false

# Optional second instance for concurrency tests (run with INSTANCE_ID=staging-b)
INSTANCE_ID=staging-a
