NEXT_PUBLIC_API_URL=
# Leave NEXT_PUBLIC_API_URL empty in dev — browser uses same-origin /api/* proxy (LAN-safe).
# Production: NEXT_PUBLIC_API_URL=https://api.homigo.com
BACKEND_ORIGIN=http://localhost:3000
# Port the backend listens on; used for SSR requests and the derived ws:// URL when NEXT_PUBLIC_API_URL is empty.
NEXT_PUBLIC_API_PORT=3000
# WebSocket override. Leave empty in dev (derived from the page host). Production: wss://api.homigo.com
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_ENV=development

# Google Maps JavaScript API (command-center map). Billable: restrict by HTTP referrer in the
# Cloud Console and keep the real value in .env.local, never in this template.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=homigo-g4
SENTRY_PROJECT=node-fastify
