NEXT_PUBLIC_API_URL=http://localhost:3000
# If you open the app via LAN IP (e.g. http://172.18.176.1:3002), set this to your machine IP:
# NEXT_PUBLIC_API_URL=http://172.18.176.1:3000
NEXT_PUBLIC_APP_NAME=HOMIGO Pro

# Release builds (`npm run build:release` refuses to build without these — scripts/release-env.cjs):
# the backend the same-origin /api proxy forwards to (https, never localhost), and the realtime url (wss).
# BACKEND_ORIGIN=https://api.example.com
# NEXT_PUBLIC_WS_URL=wss://api.example.com

# Google Maps JS (partner live map). PUBLIC — restrict by HTTP referrer in Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=homigo-g4
SENTRY_PROJECT=node-fastify
