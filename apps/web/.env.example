NEXT_PUBLIC_API_URL=
# Leave NEXT_PUBLIC_API_URL empty in dev — browser uses same-origin /api/* proxy (LAN-safe).
# Production: NEXT_PUBLIC_API_URL=https://api.homigo.com
BACKEND_ORIGIN=http://localhost:3000
# Match backend REGISTER_REQUIRE_OTP=false for local signup without SMS
NEXT_PUBLIC_REGISTER_REQUIRE_OTP=false
NEXT_PUBLIC_APP_NAME=HOMIGO
NEXT_PUBLIC_APP_TAGLINE=The Future of Home Services

# Backend Google OAuth redirect (set on API server, must match Google Cloud console)
# GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Google Maps JavaScript API (browser map). The key reaches the browser, so it cannot be kept
# secret — but it is billable, so restrict it by HTTP referrer in the Cloud Console and keep the
# real value in .env.local. A template committed to git is the one place it must never live:
# rotating a key that is in the history is far harder than rotating one that is not.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=homigo-g4
SENTRY_PROJECT=node-fastify
